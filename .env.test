# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# A non-empty VAPID public key so the push meta tags/panel render (the "push enabled" branch); the
# private key stays empty, so no real push is ever attempted in tests (WebPushSender is a no-op).
VAPID_PUBLIC_KEY='test-vapid-public-key'
# A known cron secret so the HTTP cron endpoints can be exercised end to end (both the accepted and
# the rejected token). Not a real secret: in production it comes from the host's environment.
CRON_SECRET='test-cron-secret'
# A known tick token so the scheduler's endpoint can be exercised end to end (accepted AND rejected).
# Not a real secret: in production it comes from the server's .env.local, 32 random bytes per host.
CRON_TICK_TOKEN='test-cron-tick-token'

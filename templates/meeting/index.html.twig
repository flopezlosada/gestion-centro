{% extends 'app_shell.html.twig' %}

{% block title %}Reuniones · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Reuniones{% endblock %}

{% block body %}
    {% set dias = ['', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb', 'dom'] %}
    {% set meses = ['', 'ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'] %}

    <div class="page-head">
        <div>
            <p class="eyebrow">Reuniones</p>
            <h1>Mis reuniones</h1>
            <p class="lead">Las reuniones a las que te convocan y las que convocas tú. Cuando termina una, su acta se queda aquí.</p>
        </div>
        {% if canConvene %}<a class="btn" href="{{ path('meeting_new') }}">+ Convocar reunión</a>{% endif %}
    </div>

    {#- Convocar con la lista ya hecha: tu departamento, tus proyectos y los grupos de convocatoria, en UNA
        fila bajo la cabecera y no en una tarjeta de botones. Los grupos van en un desplegable con buscador:
        con los del horario de Peñalara son casi cuarenta y como botones tapaban la pantalla entera. Todo por
        GET, así que sin JS funciona igual (el servidor marca a los convocados con ?departamento= / ?proyecto=
        / ?grupo=). -#}
    {% if canConvene and (projects is not empty or ownDepartment or meetingGroups is not empty) %}
        <div class="convene-bar">
            <span class="convene-bar__label">Con la lista ya marcada</span>
            {% if ownDepartment %}
                <a class="btn secondary btn-sm" href="{{ path('meeting_new', { departamento: 'mi' }) }}">{{ ownDepartment.name }}</a>
            {% endif %}
            {% for project in projects %}
                <a class="btn secondary btn-sm" href="{{ path('meeting_new', { proyecto: project.id }) }}">{{ project.name }}</a>
            {% endfor %}
            {% if meetingGroups is not empty %}
                <form method="get" action="{{ path('meeting_new') }}" class="convene-bar__group">
                    <label for="convocar-grupo" class="visually-hidden">Grupo de convocatoria</label>
                    <select id="convocar-grupo" name="grupo" required>
                        <option value="">Un grupo de convocatoria…</option>
                        {% for group in meetingGroups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}
                    </select>
                    <button type="submit" class="btn secondary btn-sm">Convocar</button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <section class="home-section">
        <div class="home-section__head">
            <h2 class="home-section__title">Próximas</h2>
        </div>
        {% if upcoming is empty %}
            <p class="home-empty">No tienes ninguna reunión convocada.</p>
        {% else %}
            <div class="panel">
                <ul class="tasklist tasklist--panel meeting-list">
                    {% for meeting in upcoming %}
                        {% set mine = meeting.convener and meeting.convener.id == app.user.id %}
                        <li class="tasklist__item">
                            {#- La fecha, lo primero que se busca en una reunión, en su propio bloque: el día de la
                                semana, el número y el mes, en mono para que las filas cuadren entre sí. -#}
                            <span class="meeting-date" aria-hidden="true">
                                <span class="meeting-date__wd">{{ dias[meeting.startAt|date('N')] }}</span>
                                <span class="meeting-date__day">{{ meeting.startAt|date('j') }}</span>
                                <span class="meeting-date__month">{{ meses[meeting.startAt|date('n')] }}</span>
                            </span>
                            <a class="tasklist__body" href="{{ path('meeting_show', { id: meeting.id }) }}">
                                <span class="tasklist__title">{{ meeting.title }}</span>
                                <span class="tasklist__meta">
                                    <span class="visually-hidden">{{ meeting.startAt|date('d/m/Y') }}, </span>
                                    {{- meeting.startAt|date('H:i') }}{% if meeting.endAt %}–{{ meeting.endAt|date('H:i') }}{% endif -%}
                                    {%- if meeting.place %} <span class="tasklist__sep">·</span> {{ meeting.place }}{% endif -%}
                                    {%- if meeting.type %} <span class="tasklist__sep">·</span> {{ meeting.type.name }}{% endif -%}
                                    {%- if meeting.project %} <span class="tasklist__sep">·</span> {{ meeting.project.name }}{% endif -%}
                                </span>
                                {% if mine %}
                                    <span class="meeting-list__flags">
                                        <span class="chip-neutral">Convocas</span>
                                        {#- Ámbar: hay algo que hacer, no algo que urge. Las semanales llegan sin
                                            orden del día y solo quien convoca puede escribirlo. -#}
                                        {% if not meeting.agenda %}<span class="chip-todo">Falta el orden del día</span>{% endif %}
                                    </span>
                                {% endif %}
                            </a>
                            <span class="tasklist__go" aria-hidden="true">›</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </section>

    <section class="home-section">
        <div class="home-section__head">
            <h2 class="home-section__title">Celebradas</h2>
        </div>
        {% if past is empty %}
            <p class="home-empty">Aquí aparecerán las reuniones ya celebradas, con su acta.</p>
        {% else %}
            <div class="card">
                <table>
                    <thead>
                        <tr><th>Reunión</th><th>Cuándo</th><th>Acta</th></tr>
                    </thead>
                    <tbody>
                        {% for meeting in past %}
                            <tr>
                                <td><a href="{{ path('meeting_show', { id: meeting.id }) }}">{{ meeting.title }}</a>{% if meeting.project %} <span class="help">{{ meeting.project.name }}</span>{% endif %}</td>
                                <td>{{ meeting.startAt|date('d/m/Y') }} · {{ meeting.startAt|date('H:i') }}</td>
                                <td>
                                    {# Un listado nunca ofrece un borrador: hasta que se publica, el acta es
                                       de quien la levanta, y su sitio es el detalle de la reunión. Que EXISTE
                                       sí se dice, para que quien la subió no la crea perdida. #}
                                    {% if meeting.minutesPublished %}
                                        <a href="{{ path('meeting_minutes_download', { id: meeting.id }) }}">Descargar acta</a>
                                    {% elseif meeting.hasMinutes %}
                                        <span class="help">En preparación</span>
                                    {% else %}
                                        <span class="help">Sin acta todavía</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}

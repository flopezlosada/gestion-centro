{% extends 'app_shell.html.twig' %}

{% block title %}{{ meeting.title }} · {{ app_organization_name }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('meeting_index') }}">Reuniones</a><span class="sep">/</span>
    Reunión
{% endblock %}

{# Pantalla empujada. #}
{% block bottomnav %}{% endblock %}

{% block body %}
    <div class="backbar">
        <a class="backbar__back" href="{{ path('meeting_index') }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>Reuniones</a>
        {% if canManage %}<a class="backbar__edit" href="{{ path('meeting_edit', { id: meeting.id }) }}">Modificar</a>{% endif %}
    </div>

    <div class="page-head">
        <div>
            <p class="eyebrow">{% if meeting.project %}{{ meeting.project.name }}{% else %}Reunión{% endif %}</p>
            <h1>{{ meeting.title }}</h1>
            <p class="lead">
                {{ meeting.startAt|date('d/m/Y') }} · {{ meeting.startAt|date('H:i') }}{% if meeting.endAt %}–{{ meeting.endAt|date('H:i') }}{% endif %}
                {%- if meeting.place %} · {{ meeting.place }}{% endif %}
                {%- if meeting.onlineUrl %} · por videollamada{% endif %}
            </p>
        </div>
    </div>

    <div class="detail-cols">
      <div class="detail-main">
        {#- La videollamada, lo primero de la columna que se lee: es a lo que se viene a esta pantalla cinco
            minutos antes. Una fila con su dirección a la vista (se sabe a dónde lleva antes de pulsar), no un
            botón suelto en la esquina de la cabecera, lejos de todo lo demás. -#}
        {% if meeting.onlineUrl %}
            <div class="handin handin--call">
                <span class="handin__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3"/></svg></span>
                <div class="handin__text">
                    <div class="handin__title">Por videollamada</div>
                    <div class="handin__sub">{{ meeting.onlineUrl|replace({'https://': '', 'http://': ''}) }}</div>
                </div>
                <a class="btn btn-sm" href="{{ meeting.onlineUrl }}" target="_blank" rel="noopener noreferrer">Unirse</a>
            </div>
        {% endif %}
        <div class="detail-block">
            <div class="detail-block__label">Orden del día</div>
            {% if meeting.agenda %}
                <div class="detail-prose document-body">{{ meeting.agenda|sanitize_html('app.meeting_prose') }}</div>
            {% else %}
                {#- Las semanales se crean solas y sin orden del día: quien puede escribirlo lo tiene aquí a mano,
                    no solo en el «Modificar» de la barra de arriba, que pasaba desapercibido. -#}
                <p class="help">Sin orden del día.{% if canManage %} <a href="{{ path('meeting_edit', { id: meeting.id }) }}#meeting_form_agenda">Escribir el orden del día</a>{% endif %}</p>
            {% endif %}
        </div>

        {# ---- El acta de la reunión anterior del mismo grupo, mientras esté por aprobar: su aprobación es el
               primer punto de esta, y el centro pidió darla desde aquí con un clic una vez vistas las
               observaciones, sin ir a buscar la otra reunión. Solo quien levantó ESA acta la da por aprobada. ---- #}
        {% if previousPending %}
            <div class="detail-block">
                <div class="detail-block__label">Acta anterior · pendiente de aprobación</div>
                <p>Reunión del {{ previousPending.startAt|date('d/m/Y') }}.
                    {%- if previousPending.wereMinutesEverPublished %}
                        <a href="{{ path('meeting_show', { id: previousPending.id }) }}">Ver el acta{% if previousRemarks > 0 %} y sus {{ previousRemarks }} observacion{{ previousRemarks == 1 ? '' : 'es' }}{% endif %}</a>.
                    {%- else %}
                        Su acta todavía no se ha publicado, así que aún no se puede aprobar.
                    {%- endif %}
                </p>
                {% if canApprovePrevious and previousPending.wereMinutesEverPublished %}
                    <form method="post" action="{{ path('meeting_minutes_approve', { id: previousPending.id }) }}" data-confirm="¿Dar por aprobada el acta de la reunión del {{ previousPending.startAt|date('d/m/Y') }}?">
                        <input type="hidden" name="_token" value="{{ csrf_token('meeting_minutes' ~ previousPending.id) }}">
                        <input type="hidden" name="volver" value="{{ meeting.id }}">
                        <button type="submit" class="btn secondary">Dar el acta anterior por aprobada</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

        {# ---- El acta: lo que pasó en la sesión (asistencia, desarrollo, acuerdos) y el documento que sale de ello.

               Quien la ESCRIBE la ve en el orden en que se trabaja: pasar lista, escribir, generar el PDF y
               publicarlo. Antes iba al revés —arriba el PDF con seis botones del mismo peso, abajo lo que se
               escribe, y «Guardar» al final de la lista de asistencia— y generar el PDF era un formulario
               aparte que no mandaba lo escrito: se perdía. Ahora es un único formulario con su barra de
               acciones pegada abajo, y debajo el documento con UNA acción principal según en qué punto esté.

               Quien solo asiste ve el acta publicada y el texto, como siempre.

               Con alumnado o con familias no hay acta AQUÍ —eso va a RAICES, y duplicarlo dejaría dos medios
               registros— pero sí lista: quién vino a una entrevista es un dato de esta cita. ---- #}
        {% if not meeting.keepsMinutes %}
            <div class="callout">
                <p>{{ meeting.scope.note }}</p>
            </div>
        {% endif %}

        {% set minutesState = not meeting.hasMinutes ? null : (not meeting.minutesPublished ? 'borrador' : 'publicada') %}
        {% set minutesLabel -%}
            {%- if meeting.keepsMinutes %}Acta
                {%- if minutesState %} · {{ minutesState }}{% endif %}
                {%- if meeting.minutesApprovalRequired and meeting.minutesPublished %} · {% if meeting.areMinutesApproved %}aprobada el {{ meeting.minutesApprovedAt|date('d/m/Y') }}{% else %}pendiente de aprobación{% endif %}{% endif %}
            {%- else %}Asistencia{% endif -%}
        {%- endset %}

        {% if canWriteMinutes and isHeld %}
            <div class="detail-block">
                <div class="detail-block__label">{{ minutesLabel }}</div>

                {# El PDF es más viejo que lo escrito: alguien ha corregido después de generarlo. #}
                {% if meeting.keepsMinutes and meeting.minutesOutdated %}
                    <div class="callout callout--warning">
                        <p><strong>El acta se ha modificado después de generar el PDF.</strong>
                        {%- if meeting.minutesPublished %} El archivo publicado es el anterior: genéralo otra vez y publícalo para que la corrección llegue.
                        {%- else %} Genéralo otra vez para que recoja los cambios.{% endif %}</p>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('meeting_record', { id: meeting.id }) }}" class="minutes-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('meeting_record' ~ meeting.id) }}">

                    {#- La lista primero: se pasa al empezar, y en columnas para que un claustro no empuje lo
                        demás varias pantallas abajo. Guardarla vacía es «no vino nadie», distinto de no
                        haber pasado lista. -#}
                    <fieldset class="minutes-roll">
                        <legend class="minutes-roll__head">
                            <span>Asistencia</span>
                            {% if meeting.attendanceTaken %}<span class="minutes-roll__count">· asistieron {{ meeting.attended|length }} de {{ meeting.people|length }}</span>{% endif %}
                        </legend>
                        <button type="button" class="link-btn minutes-roll__all" data-check-all="asistentes[]" hidden>Marcar a todos</button>
                        <div class="minutes-roll__grid">
                            {% for person in meeting.people %}
                                <label class="minutes-roll__person" title="{{ person.unit ? person.unit.name : 'Sin departamento' }}">
                                    <input type="checkbox" name="asistentes[]" value="{{ person.id }}"{{ meeting.attended.contains(person) ? ' checked' : '' }}>
                                    <span>{{ person.fullName }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>

                    {% if meeting.keepsMinutes %}
                        {# Dos cuadros y no uno: el centro los pidió por su nombre, y los acuerdos son la parte
                           que se busca meses después. El orden del día se escribe al convocar. #}
                        <div class="form-row">
                            <label for="tratado">Desarrollo de la reunión</label>
                            <textarea id="tratado" name="tratado" rows="8" data-rich-text placeholder="Se abre la sesión a las…&#10;Sobre el primer punto…">{{ meeting.discussion }}</textarea>
                        </div>
                        <div class="form-row">
                            <label for="acuerdos">Acuerdos</label>
                            <textarea id="acuerdos" name="acuerdos" rows="6" data-rich-text placeholder="1. Se acuerda…&#10;2. Se aprueba…">{{ meeting.agreements }}</textarea>
                        </div>
                    {% endif %}

                    {#- Pegada abajo mientras se escribe: guardar no puede quedar al final de una lista larga.
                        Generar el PDF sale de AQUÍ y no de un botón aparte: guarda primero y genera después,
                        así que el PDF es siempre lo que hay en pantalla. -#}
                    {#- Una sola acción principal en pantalla: generar mientras no hay PDF o el que hay se ha
                        quedado viejo; si está al día, lo siguiente es publicarlo, y el naranja va allí. -#}
                    {% set generateIsNext = not meeting.hasMinutes or meeting.minutesOutdated %}
                    <div class="minutes-form__bar">
                        <button class="btn{{ meeting.keepsMinutes ? ' secondary' }}" type="submit">{{ meeting.keepsMinutes ? 'Guardar' : 'Guardar la asistencia' }}</button>
                        {% if meeting.keepsMinutes %}
                            <button class="btn{{ generateIsNext ? '' : ' secondary' }}" type="submit" name="generar" value="1"{% if meeting.hasMinutes %} data-confirm="Se sustituirá el PDF que hay ahora por uno nuevo con lo que has escrito. ¿Seguir?"{% endif %}>{{ meeting.hasMinutes ? 'Guardar y volver a generar el PDF' : 'Guardar y generar el PDF' }}</button>
                        {% endif %}
                    </div>
                </form>

                {% if meeting.keepsMinutes %}
                    <div class="minutes-doc">
                        <div class="detail-block__label">El documento</div>
                        {% if meeting.hasMinutes %}
                            <a class="doc-card" href="{{ path('meeting_minutes_download', { id: meeting.id }) }}">
                                <span class="doc-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg></span>
                                <span class="doc-card__body">
                                    <span class="doc-card__name">{{ meeting.minutesName ?: 'Acta de la reunión' }}</span>
                                    <span class="doc-card__meta">
                                        Subida{% if meeting.minutesUploadedAt %} el {{ meeting.minutesUploadedAt|date('d/m/Y') }}{% endif %}
                                        {%- if meeting.minutesUploadedBy %} por {{ meeting.minutesUploadedBy.fullName }}{% endif %}
                                    </span>
                                </span>
                                <span class="doc-card__open">Descargar</span>
                            </a>

                            {#- Una sola acción principal, la que toca: publicar el borrador o, ya publicada,
                                darla por aprobada si la reunión lo requiere. Aprobar un borrador que nadie ha
                                leído no tiene sentido, así que no se ofrece antes de publicar. Aprobarla y
                                quitarla son de quien LEVANTA el acta: certifican o destruyen el registro. -#}
                            {% if not meeting.minutesPublished %}
                                <div class="minutes-doc__next">
                                    <p class="help"><strong>Es un borrador.</strong> Solo lo ves tú hasta que lo publiques.</p>
                                    <form method="post" action="{{ path('meeting_minutes_publish', { id: meeting.id }) }}" data-confirm="¿Publicar el acta? Se enviará por correo, con el PDF adjunto, a todas las personas convocadas.">
                                        <input type="hidden" name="_token" value="{{ csrf_token('meeting_minutes' ~ meeting.id) }}">
                                        <button type="submit" class="btn{{ meeting.minutesOutdated ? ' secondary' }}">Publicar y enviar por correo</button>
                                    </form>
                                </div>
                            {% else %}
                                <div class="minutes-doc__next">
                                    <p class="help">Publicada el {{ meeting.minutesPublishedAt|date('d/m/Y', false) }}{% if meeting.minutesPublishedBy %} por {{ meeting.minutesPublishedBy.fullName }}{% endif %}. Ya la tienen todos por correo y en su apartado de actas.</p>
                                    {% if canKeepMinutes and meeting.minutesApprovalRequired and not meeting.areMinutesApproved %}
                                        <form method="post" action="{{ path('meeting_minutes_approve', { id: meeting.id }) }}" data-confirm="¿Dar el acta por aprobada?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('meeting_minutes' ~ meeting.id) }}">
                                            <button type="submit" class="btn">Dar el acta por aprobada</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% else %}
                            <p class="help">Todavía no hay PDF. Sale de lo escrito arriba con «Guardar y generar el PDF».</p>
                        {% endif %}

                        {#- Lo que se usa poco, plegado: un acta escrita fuera de la app, o quitarla. -#}
                        <details class="minutes-more">
                            <summary>Otras opciones</summary>
                            <form method="post" action="{{ path('meeting_minutes_upload', { id: meeting.id }) }}" enctype="multipart/form-data" class="deliverable-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('meeting_minutes' ~ meeting.id) }}">
                                <label class="classcard__file">
                                    <span class="visually-hidden">Archivo del acta</span>
                                    <input type="file" name="acta" required data-max-bytes="{{ constant('App\\Support\\DocumentUpload::MAX_BYTES') }}">
                                </label>
                                <button class="btn secondary" type="submit">{{ meeting.hasMinutes ? 'Sustituir por este archivo' : 'Subir un acta hecha aparte' }}</button>
                            </form>
                            <p class="help">Si el acta se ha escrito fuera de la app. PDF, Office, texto o imagen, hasta {{ (constant('App\\Support\\DocumentUpload::MAX_BYTES') / 1024 / 1024)|round }} MB.</p>
                            {% if canKeepMinutes and meeting.hasMinutes %}
                                <form method="post" action="{{ path('meeting_minutes_delete', { id: meeting.id }) }}" data-confirm="¿Quitar el acta de esta reunión?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('meeting_minutes' ~ meeting.id) }}">
                                    <button type="submit" class="link-danger">Quitar el acta</button>
                                </form>
                            {% endif %}
                        </details>
                    </div>
                {% endif %}
            </div>
        {% else %}
            {# Quien no la escribe (o todavía no se puede): el documento si ya salió, y el texto. #}
            {% if meeting.keepsMinutes %}
                <div class="detail-block">
                    <div class="detail-block__label">{{ minutesLabel }}</div>
                    {% if meeting.minutesOutdated and meeting.minutesPublished %}
                        <div class="callout callout--warning">
                            <p><strong>El acta se ha modificado después de generar el PDF.</strong> El archivo publicado es el anterior.</p>
                        </div>
                    {% endif %}
                    {% if meeting.hasMinutes and meeting.minutesPublished %}
                        <a class="doc-card" href="{{ path('meeting_minutes_download', { id: meeting.id }) }}">
                            <span class="doc-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg></span>
                            <span class="doc-card__body">
                                <span class="doc-card__name">{{ meeting.minutesName ?: 'Acta de la reunión' }}</span>
                                <span class="doc-card__meta">Publicada el {{ meeting.minutesPublishedAt|date('d/m/Y', false) }}</span>
                            </span>
                            <span class="doc-card__open">Descargar</span>
                        </a>
                    {% elseif meeting.hasMinutes %}
                        <p class="help">El acta está en preparación. Cuando se publique, la recibirás por correo.</p>
                    {% elseif not isHeld and canWriteMinutes %}
                        <p class="help">Podrás pasar lista y escribir el acta en cuanto empiece la reunión ({{ meeting.startAt|date('d/m/Y H:i') }}).</p>
                    {% else %}
                        <p class="help">Todavía no hay acta de esta reunión.</p>
                    {% endif %}
                </div>
            {% elseif not isHeld and canWriteMinutes %}
                <div class="detail-block">
                    <div class="detail-block__label">Asistencia</div>
                    <p class="help">Podrás pasar lista en cuanto empiece la reunión ({{ meeting.startAt|date('d/m/Y H:i') }}).</p>
                </div>
            {% endif %}

            {% if isHeld %}
                <div class="detail-block">
                    {% if meeting.keepsMinutes %}
                        <div class="detail-block__label">Desarrollo de la reunión</div>
                        {% if meeting.discussion %}
                            <div class="detail-prose document-body">{{ meeting.discussion|sanitize_html('app.meeting_prose') }}</div>
                        {% else %}
                            <p class="help">Todavía no se ha recogido el desarrollo.</p>
                        {% endif %}
                        {% if meeting.agreements %}
                            <div class="detail-block__label">Acuerdos</div>
                            <div class="detail-prose document-body">{{ meeting.agreements|sanitize_html('app.meeting_prose') }}</div>
                        {% endif %}
                    {% endif %}
                    <div class="detail-block__label">Asistencia{% if meeting.attendanceTaken %} · asistieron {{ meeting.attended|length }} de {{ meeting.people|length }}{% endif %}</div>
                    {% if meeting.attendanceTaken %}
                        <p class="detail-prose">Asistió: {% for person in meeting.attended %}{{ person.fullName }}{% if not loop.last %} · {% endif %}{% else %}nadie{% endfor %}</p>
                        {% if meeting.absentees is not empty %}
                            <p class="help">No asistió: {% for person in meeting.absentees %}{{ person.fullName }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
                        {% endif %}
                    {% else %}
                        <p class="help">Todavía no se ha pasado lista.</p>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}

        {# ---- Observaciones al acta publicada. El acta no la reescribe quien asiste, pero puede decir que
               una línea no dice lo que se acordó: eso es esto. No entra en el PDF —el acta es lo que aprobó
               el órgano, no un hilo— y llega como aviso a quien la levanta y a quien convocó, que son los
               dos que pueden corregirla. ---- #}
        {% if meeting.wereMinutesEverPublished and meeting.keepsMinutes and (remarks is not empty or canRemark) %}
            <div class="detail-block" id="observaciones">
                <div class="detail-block__label">Observaciones al acta{% if remarks is not empty %} · {{ remarks|length }}{% endif %}</div>
                {% if remarks is empty %}
                    <p class="help">Nadie ha puntualizado el acta.</p>
                {% else %}
                    <ol class="thread">
                        {% for remark in remarks %}
                            <li class="thread__item">
                                <div class="thread__head">
                                    <span class="thread__who">{{ remark.author ? remark.author.fullName : 'Alguien que ya no está en el centro' }}</span>
                                    <time class="thread__when" datetime="{{ remark.createdAt|date('c') }}">{{ remark.createdAt|date('d/m/Y H:i', false) }}</time>
                                </div>
                                <p class="thread__body">{{ remark.body|nl2br }}</p>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}

                {% if canRemark %}
                    <form method="post" action="{{ path('meeting_remark', { id: meeting.id }) }}" class="thread__form">
                        <input type="hidden" name="_token" value="{{ csrf_token('meeting_remark' ~ meeting.id) }}">
                        <label class="visually-hidden" for="observacion">Escribe una observación al acta</label>
                        <textarea id="observacion" name="observacion" rows="2" maxlength="{{ constant('App\\Entity\\MeetingRemark::MAX_LENGTH') }}" placeholder="Ej.: en el punto 3 se acordó aplazarlo, no aprobarlo."></textarea>
                        <button type="submit" class="btn secondary">Añadir observación</button>
                    </form>
                    <p class="help">No cambia el acta: la comenta. Se avisa a quien la levanta y a quien convocó, que son quienes pueden corregirla y volver a publicarla.</p>
                {% endif %}
            </div>
        {% endif %}
      </div>{# /detail-main #}

      <aside class="detail-aside">
        <div class="detail-block">
            <div class="detail-block__label">La convocatoria</div>
            <dl class="meta-grid">
                <div class="meta-grid__cell"><dt>Convoca</dt><dd>{{ meeting.convener ? meeting.convener.fullName : '—' }}</dd></div>
                <div class="meta-grid__cell"><dt>Levanta el acta</dt><dd>{{ meeting.minutesKeeper ? meeting.minutesKeeper.fullName : '—' }}</dd></div>
                <div class="meta-grid__cell"><dt>Cuándo</dt><dd>{{ meeting.startAt|date('d/m/Y H:i') }}</dd></div>
                <div class="meta-grid__cell"><dt>Lugar</dt><dd>{{ meeting.place ?: '—' }}</dd></div>
                <div class="meta-grid__cell"><dt>Proyecto</dt><dd>{{ meeting.project ? meeting.project.name : '—' }}</dd></div>
                {#- Se enseña a todos, no solo a quien convoca: saber si vas a recibir el aviso (o si te
                    tienes que acordar tú) es justo lo que uno quiere comprobar al leer la convocatoria. -#}
                <div class="meta-grid__cell"><dt>Aviso</dt><dd>{{ meeting.reminder ? meeting.reminder.label : 'Sin aviso' }}</dd></div>
            </dl>
        </div>

        <div class="detail-block">
            <div class="detail-block__label">Personas convocadas · {{ meeting.attendees|length }}</div>
            {% if meeting.attendees is empty %}
                <p class="help">Nadie más está convocado.</p>
            {% else %}
                {#- Como prosa separada por puntos, no como lista: en la columna estrecha del aside una
                    lista de una línea por nombre ocupa media pantalla y no aporta nada. -#}
                <p class="detail-prose">{% for attendee in meeting.attendees %}{{ attendee.fullName }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
            {% endif %}
        </div>

        {% if canManage %}
            <div class="detail-block">
                <div class="detail-block__label">Cancelar</div>
                <form method="post" action="{{ path('meeting_delete', { id: meeting.id }) }}" data-confirm="¿Cancelar la reunión «{{ meeting.title }}»? Se borra también su acta.">
                    <input type="hidden" name="_token" value="{{ csrf_token('meeting_delete' ~ meeting.id) }}">
                    <button type="submit" class="link-danger">Cancelar la reunión</button>
                </form>
                <p class="help">Se avisa a todas las personas convocadas de que la reunión se ha cancelado.</p>
            </div>
        {% endif %}
      </aside>{# /detail-aside #}
    </div>{# /detail-cols #}
{% endblock %}

{#- El editor con formato solo hace falta a quien escribe el acta; al resto le basta el texto ya pintado. -#}
{% block stylesheets %}
    {{ parent() }}
    {% if canWriteMinutes %}<link rel="stylesheet" href="{{ asset_ver('/vendor/trix/trix.css') }}">{% endif %}
{% endblock %}

{% block page_scripts %}
    {% if canWriteMinutes %}
        <script src="{{ asset_ver('/vendor/trix/trix.umd.min.js') }}"></script>
        <script src="{{ asset_ver('/js/rich-text.js') }}"></script>
        <script src="{{ asset_ver('/js/check-all.js') }}"></script>
    {% endif %}
{% endblock %}

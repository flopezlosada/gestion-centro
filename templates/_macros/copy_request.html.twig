{#
   El estado de un encargo de fotocopias, en una insignia. Tres, y solo lo que la aplicación sabe de
   verdad: «Sin enviar» (el correo falló), «Enviada» (salió hacia conserjería) y «Hecha» (conserjería la
   marcó). No «En cola»: conserjería trabaja desde su buzón, casi nunca marca nada aquí, y «en cola» hacía
   creer que un encargo ya entregado seguía esperando. La hora va en el `title` y no en el texto: el filtro
   de la tabla agrupa por el texto entero de la celda (table-tools.js).
#}
{% macro status_badge(order) %}
    {%- if order.done -%}
        <span class="badge badge--success" data-tone="success" title="Hecha el {{ order.doneAt|date('d/m/Y', false) }} a las {{ order.doneAt|date('H:i', false) }}">Hecha</span>
    {%- elseif not order.isSent -%}
        <span class="badge badge--danger" data-tone="danger">Sin enviar</span>
    {%- else -%}
        <span class="badge badge--accent" data-tone="accent" title="Enviada a conserjería el {{ order.sentAt|date('d/m/Y', false) }} a las {{ order.sentAt|date('H:i', false) }}">Enviada</span>
    {%- endif -%}
{% endmacro %}

{% extends 'app_shell.html.twig' %}

{% block title %}Apuntar ausencia{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('guardia_index') }}">Guardias</a><span class="sep">/</span>Apuntar ausencia{% endblock %}

{# Pantalla empujada: fuera la barra inferior, la salida es "Cancelar" (handoff 10a). #}
{% block bottomnav %}{% endblock %}

{% block body %}
    {% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}

    <div class="formtop">
        <a class="formtop__cancel" href="{{ path('guardia_index', { date: date|date('Y-m-d', false) }) }}">Cancelar</a>
        <span class="formtop__title">Apuntar ausencia</span>
        <span class="formtop__spacer"></span>
    </div>

    <div class="formscreen">
        {% if not hasTimetable %}
            <div class="empty-state">
                <h2>No hay horario importado para el curso {{ schoolYear }}</h2>
                <p>Sin el horario del curso no se pueden generar guardias. Impórtalo y vuelve a intentarlo.</p>
                {% if is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ADMINISTRATION')) %}
                    <p><a class="btn" href="{{ path('admin_timetable_import') }}">Importar horario</a></p>
                {% endif %}
            </div>
        {% else %}
            {# Paso 1 · quién y qué día. Cambiar cualquiera recarga la lista de clases (GET). #}
            <form method="get" action="{{ path('guardia_absence_new') }}" class="absence-picker">
                <div class="pickfield">
                    <label class="eyebrow" for="absent_teacher">Docente ausente</label>
                    {% if allTeachers|length == 1 %}
                        <input type="hidden" name="teacher" value="{{ allTeachers[0].id }}">
                        <div class="pickrow">
                            <span class="pickrow__avatar" aria-hidden="true">{{ allTeachers[0].fullName|initials }}</span>
                            <span class="pickrow__value">{{ allTeachers[0].fullName }}</span>
                        </div>
                    {% else %}
                        <div class="pickrow pickrow--select">
                            {% if selectedTeacherName %}<span class="pickrow__avatar" aria-hidden="true">{{ selectedTeacherName|initials }}</span>{% endif %}
                            <select id="absent_teacher" name="teacher" onchange="this.form.submit()">
                                <option value="">Elige un docente…</option>
                                {% for teacher in allTeachers %}
                                    <option value="{{ teacher.id }}" {{ teacher.id == selectedTeacher ? 'selected' }}>{{ teacher.fullName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                </div>
                <div class="pickfield">
                    <label class="eyebrow" for="absence_date">Día</label>
                    <div class="pickrow pickrow--select">
                        <svg class="pickrow__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
                        <input type="date" id="absence_date" name="date" value="{{ date|date('Y-m-d', false) }}" onchange="this.form.submit()">
                    </div>
                </div>
                <noscript><button type="submit" class="btn secondary">Ver clases</button></noscript>
            </form>

            {# Paso 2 · clases reales de ese día del docente elegido. #}
            {% if selectedTeacher is null %}
                <p class="muted step-hint">Elige un docente para ver sus clases del {{ weekday.label|lower }}.</p>
            {% elseif dayClasses is empty and breakDuties is empty and ownGuardias is empty %}
                <div class="empty-state">
                    <h2>No tiene nada el {{ weekday.label|lower }}</h2>
                    <p>Ese día no da ninguna clase, no le toca guardia y no tiene guardia de recreo, así que no hay nada que registrar. Prueba con otro día.</p>
                </div>
            {% else %}
                <form method="post" action="{{ path('guardia_absence_create') }}" class="absence-form" enctype="multipart/form-data" data-absence-form
                      data-confirm="{% if dayClasses is empty and ownGuardias is not empty %}Se le retirarán las guardias que iba a cubrir y se repartirán entre el resto. ¿Continuar?{% elseif dayClasses is empty %}Se avisará al equipo directivo de que su recreo se queda sin vigilar. ¿Continuar?{% else %}Se generarán {{ dayClasses|length }} guardia{{ dayClasses|length == 1 ? '' : 's' }} y se avisará a quienes las cubran. ¿Continuar?{% endif %}">
                    <input type="hidden" name="_token" value="{{ csrf_token('guardia_absence_create') }}">
                    <input type="hidden" name="absent_teacher" value="{{ selectedTeacher }}">
                    <input type="hidden" name="date" value="{{ date|date('Y-m-d', false) }}">

                    {% if dayClasses is not empty %}
                        <div class="classes-head">
                            <h2 class="classes-head__title">Clases del {{ dias[date|date('N', false)]|lower }} {{ date|date('d/m', false) }}</h2>
                            {# Sin JS queda el total, que es cierto de partida (todas marcadas); con JS cuenta las marcadas. #}
                            <span class="badge badge--danger" data-absence-count aria-live="polite">falta {{ dayClasses|length }} de {{ dayClasses|length }}</span>
                        </div>
                        <p class="classes-help">Marcada = falta esa hora. Desmárcala si sí estará. En cada hora que falte puedes adjuntar la tarea.</p>
                    {% endif %}

                    <ul class="classcards">
                        {% for c in dayClasses %}
                            {% set label = c.groupCount > 1 ? (c.room ?? 'la actividad') : (c.groups|first|default('el grupo')) %}
                            <li class="classcard">
                                <label class="classcard__pick">
                                    <input type="checkbox" name="slots[]" value="{{ c.slotIndex }}" checked>
                                    <span class="classcard__box" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
                                    </span>
                                    <span class="classcard__what">
                                        <span class="classcard__time">{{ c.startsAt|date('H:i', false) }}–{{ c.endsAt|date('H:i', false) }}</span>
                                        <span class="classcard__group">
                                            {% if c.groupCount > 1 %}
                                                {# Actividad multigrupo (p.ej. Salón de Actos): el aula es la referencia, los grupos van listados. #}
                                                <strong>{{ c.room ?? 'Actividad de nivel' }}</strong>
                                                <span class="badge badge--muted">{{ c.groupCount }} grupos</span>
                                                <span class="muted mono"> · {{ c.groups|join(', ') }}</span>
                                                {% if c.subjectName %}<span class="muted mono"> · {{ c.subjectName }}</span>{% endif %}
                                            {% else %}
                                                <strong>{{ c.groups|first|default('—') }}</strong>
                                                {% if c.subjectName %}<span class="muted mono"> · {{ c.subjectName }}</span>{% endif %}
                                                {% if c.room %}<span class="muted mono"> · {{ c.room }}</span>{% endif %}
                                            {% endif %}
                                        </span>
                                        <span class="classcard__state">
                                            <span class="classcard__state--falta">Falta esta hora</span>
                                            <span class="classcard__state--asiste">Sí estará · no genera guardia</span>
                                        </span>
                                    </span>
                                </label>
                                <details class="classcard__task">
                                    <summary class="classcard__addtask">Añadir tarea para el grupo</summary>
                                    <div class="classcard__taskbody">
                                        <label class="classcard__file">
                                            <span class="field-label">Documento de tarea</span>
                                            <input type="file" name="documents[{{ c.slotIndex }}]">
                                        </label>
                                        <textarea name="description[{{ c.slotIndex }}]" rows="2" maxlength="1000"
                                                  placeholder="Descripción para {{ label }} (opcional): lo que no venga en el documento — página, ejercicios, dónde está el examen…"></textarea>
                                        {# Las copias las sabe quien falta (conoce su grupo); conserjería no puede adivinarlas. #}
                                        <label class="classcard__copies">
                                            <span class="field-label">Copias que hacen falta</span>
                                            <input type="number" name="copies[{{ c.slotIndex }}]" min="1" max="500" inputmode="numeric" placeholder="p. ej. 28">
                                            <span class="field-help">Opcional. Se propone al mandar la tarea a fotocopias; si lo dejas vacío lo pondrá quien la pida.</span>
                                        </label>
                                    </div>
                                </details>
                            </li>
                        {% endfor %}
                    </ul>

                    {% if ownGuardias is not empty %}
                        {# Las guardias que esta persona iba a CUBRIR ese día. Van aparte de sus clases porque
                           la consecuencia es la inversa: no generan una guardia nueva, se le retiran y el grupo
                           pasa a otro compañero. Sin esta sección, quien ese día solo tenía guardias veía «no
                           hay nada que registrar» y su grupo se quedaba esperando a alguien que no iba a venir. #}
                        <div class="form-row field--own-guardias">
                            <label class="eyebrow">Guardias que iba a cubrir</label>
                            <ul class="classcards">
                                {% for g in ownGuardias %}
                                    <li class="classcard">
                                        <label class="classcard__pick">
                                            <input type="checkbox" name="slots[]" value="{{ g.slotIndex }}" checked>
                                            <span class="classcard__box" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
                                            </span>
                                            <span class="classcard__what">
                                                <span class="classcard__time">{{ (g.slotIndex + 1) }}.ª hora</span>
                                                <span class="classcard__group">
                                                    <strong>{{ g.groupName ?? 'un grupo' }}</strong>
                                                    <span class="muted mono"> · cubría a {{ g.absentTeacher.fullName }}</span>
                                                </span>
                                                <span class="classcard__state">
                                                    <span class="classcard__state--falta">Falta esta hora · se le retira</span>
                                                    <span class="classcard__state--asiste">Sí estará · la sigue cubriendo</span>
                                                </span>
                                            </span>
                                        </label>
                                    </li>
                                {% endfor %}
                            </ul>
                            <p class="field-help">Al registrar la ausencia se le <strong>retiran</strong> estas guardias y el grupo se reparte entre quien sí esté. Desmárcala si va a venir a hacerla igualmente.</p>
                        </div>
                    {% endif %}

                    {% if breakDuties is not empty %}
                        {# Los recreos van aparte de las clases a propósito: no son horas que nadie dé, así
                           que no aparecen en la lista de arriba, y su consecuencia es la contraria — no se
                           genera guardia ninguna, se avisa al equipo directivo. Marcado por defecto porque
                           si falta, falta; desmarcarlo es para el caso de que venga solo a hacer el recreo.
                           Pueden ser DOS (el grande y el corto), y faltar a los dos son dos voluntarios que
                           buscar, no uno. #}
                        <div class="form-row field--break">
                            <label class="eyebrow">{{ breakDuties|length == 1 ? 'Guardia de recreo' : 'Guardias de recreo' }}</label>
                            <label class="choice">
                                <input type="checkbox" name="misses_break" value="1" checked>
                                También falta
                                {% for d in breakDuties %}
                                    {{ loop.first ? 'al' : 'y al' }} {{ d.period.label|lower }}: <strong>{{ d.zone.name }}</strong>
                                    <span class="muted"> · {{ include('guardia/_break_times.html.twig', {duty: d, breakSlots: breakSlots}) }}</span>
                                {% endfor %}
                            </label>
                            <p class="field-help">{{ breakDuties|length == 1 ? 'Ese recreo' : 'Esos recreos' }} <strong>no se {{ breakDuties|length == 1 ? 'reasigna' : 'reasignan' }}</strong> (no hay personal): se avisa al equipo directivo para que busque {{ breakDuties|length == 1 ? 'una persona voluntaria' : 'personas voluntarias' }}, y queda registrado en «Recreos sin vigilar».</p>
                        </div>
                    {% endif %}

                    <div class="form-row field--reason">
                        <label class="eyebrow" for="absence_reason">Motivo de la ausencia · privado</label>
                        <textarea id="absence_reason" name="reason" rows="2" maxlength="500"
                                  placeholder="Solo lo veréis el docente ausente y la coordinación de guardias. Quien cubra la guardia no lo ve."></textarea>
                        <p class="field-help">Opcional. Queda guardado con la ausencia y no se muestra a quien cubre la clase.</p>
                    </div>

                    <div class="stackform__foot">
                        <button type="submit" class="btn-lg btn-lg--primary">{{ dayClasses is empty ? 'Registrar la ausencia' : 'Generar y repartir guardias' }}</button>
                    </div>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

{% extends 'app_shell.html.twig' %}

{% block title %}Mis guardias{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Mis guardias{% endblock %}

{% block body %}
    {# La cuenta atrás es compartida con el detalle de la guardia: {@see _macros/time.html.twig}. #}
    {% import '_macros/time.html.twig' as fmt %}
    {% import '_macros/raices.html.twig' as raices %}
    {% set weekdayNames = {1: 'Lunes', 2: 'Martes', 3: 'Miércoles', 4: 'Jueves', 5: 'Viernes', 6: 'Sábado', 7: 'Domingo'} %}
    {% set nextItem = today.next is not null ? today.items[today.next] : null %}

    <div class="page-head page-head--ruled">
        <div>
            <h1>Mis guardias</h1>
            <p class="lead g-wide">Tus guardias de hoy y las que vienen. Pulsa una para ver el detalle y la tarea del grupo.</p>
        </div>
        <div class="page-head__actions">
            <a class="btn secondary" href="{{ path('guardia_mine_history') }}">Ver histórico</a>
            <a class="btn" href="{{ path('guardia_absence_new', { teacher: app.user.id }) }}">Voy a faltar…</a>
        </div>
    </div>

    {#- Hoy no se repite como lista: tus coberturas de hoy ya están en la columna de hoy de la semana, y el
        resumen (asignadas/pendientes/con tarea) contaba de una a tres casillas que se ven de un vistazo.
        Arriba solo queda lo que la semana no dice: el recordatorio de RAICES, una vez por jornada y solo si
        hoy se da alguna guardia (si TODAS son incidencia no hubo sesión de la que tomar lista; mismo criterio
        que el detalle y que el push), y la cuenta atrás de la próxima que te queda hoy. -#}
    {% set givesToday = today.items|filter(i => not i.cover.notCovered)|length > 0 %}
    {% if givesToday or nextItem %}
        <div class="mine-today">
            {% if nextItem %}
                {% set cover = nextItem.cover %}
                <a class="hero-guardia{{ cover.notCovered ? ' is-incident' }}" href="{{ path('guardia_cover_show', { id: cover.id }) }}">
                    <span class="hero-guardia__eyebrow"><span class="pulse-dot" aria-hidden="true"></span>Tu próxima guardia</span>
                    <span class="hero-guardia__timerow">
                        <span class="hero-guardia__time mono">{% if nextItem.startsAt %}{{ nextItem.startsAt|date('H:i', false) }}{% else %}{{ cover.slotIndex + 1 }}ª{% endif %}</span>
                        {% if nextItem.minutesUntil is not null %}<span class="hero-guardia__countdown mono">{{ fmt.countdown(nextItem.minutesUntil) }}</span>{% endif %}
                    </span>
                    {% if nextItem.endsAt %}<span class="hero-guardia__ends mono">termina {{ nextItem.endsAt|date('H:i', false) }}</span>{% endif %}
                    <span class="hero-guardia__sep" aria-hidden="true"></span>
                    <span class="hero-guardia__place">{{ [cover.effectiveRoomName, cover.groupName]|filter(v => v)|join(' · ') ?: 'Sin especificar' }}</span>
                    <span class="hero-guardia__teacher">Cubres a <strong>{{ cover.absentTeacher.fullName }}</strong></span>
                    {% if cover.notCovered %}<span class="hero-guardia__badge hero-guardia__badge--danger">Incidencia</span>
                    {% elseif cover.hasTask %}<span class="hero-guardia__badge hero-guardia__badge--task">Tiene tarea</span>{% endif %}
                    <span class="hero-guardia__cta">Ver detalle y tarea del grupo →</span>
                </a>
            {% endif %}
            {% if givesToday %}{{ raices.line() }}{% endif %}
        </div>
    {% endif %}

    {{ include('guardia/_week.html.twig') }}

    {{ include('guardia/_upcoming.html.twig') }}

    {# La guardia de recreo NO es una fila más del día: es fija todo el curso, así que se cuenta una vez
       como un hecho permanente ("los martes, patio") y no una vez por cada martes del año. Va fuera del
       if de arriba porque el profesor la tiene igual haya o no guardias de sustitución hoy. #}
    {% if breakDuties is not empty %}
        <section class="card">
            <h2>Mi guardia de recreo</h2>
            <table class="worklist">
                <thead><tr><th scope="col">Día</th><th scope="col">Zona</th><th scope="col">Horas</th></tr></thead>
                <tbody>
                    {% for duty in breakDuties %}
                        <tr>
                            <td>
                                <strong>{{ duty.weekday.label }}</strong>
                                {% if duty.weekday.value == todayWeekday.value %}<span class="badge badge--accent">Hoy</span>{% endif %}
                            </td>
                            <td>{{ duty.zone.name }}</td>
                            <td class="mono">{{ include('guardia/_break_times.html.twig', {duty: duty, breakSlots: breakSlots}) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="help">Es la misma todo el curso. Si vas a faltar, apúntalo en «Voy a faltar…» y marca también el recreo: no se reasigna a nadie, pero avisa al equipo directivo para buscar una persona voluntaria.</p>
        </section>
    {% endif %}
{% endblock %}

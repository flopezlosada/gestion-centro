{% extends 'app_shell.html.twig' %}

{% set canWrite = is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::GUARDIAS')) %}
{% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}

{% block title %}Parte de guardias{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Parte de guardias{% endblock %}

{#
   La hoja para asignar una ausencia concreta (handoff 8b): candidatos que el reparto elegiría,
   primero quien menos carga lleva, y debajo quién NO puede cubrir y por qué. Se abre con <details>
   para no depender de JS. `libres` son los GuardiaCandidate ya priorizados por el scheduler.

   En déficit la lista incluye a compañeros que YA cubren un grupo a esa hora (hereLoad > 0): salen al
   final, marcados, y el botón dice «Doblar» en vez de «Asignar» — que quede claro que asignarlos es
   ponerles un segundo grupo, no darles trabajo nuevo.
#}
{% macro assign_sheet(cover, libres, pool, assignedHere, slotLabel) %}
    <details class="assignsheet">
        <summary class="assignsheet__toggle">Asignar profesor</summary>
        <div class="assignsheet__panel">
            <div class="assignsheet__head">
                <div class="eyebrow">Asignar guardia</div>
                <h3 class="assignsheet__title">{{ cover.groupName ?? 'Sin grupo' }}{% if cover.roomName %} · {{ cover.roomName }}{% endif %}
                    {% if slotLabel %}<span class="assignsheet__when">· {{ slotLabel }}</span>{% endif %}
                </h3>
                <p class="assignsheet__sub">Falta {{ cover.absentTeacher.fullName }} · profesores libres, primero quien menos lleva</p>
            </div>

            <div class="assignsheet__list">
                {% for c in libres %}
                    <form method="post" action="{{ path('guardia_cover_assign', { id: cover.id }) }}" class="assignsheet__row{{ c.doublingUp ? ' is-doubling' }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('guardia_cover_assign' ~ cover.id) }}">
                        <input type="hidden" name="guardia" value="{{ c.teacher.id }}">
                        <span class="assignsheet__load" title="{{ c.slotLoad }} guardia(s) en este tramo">{{ c.slotLoad }}</span>
                        <span class="assignsheet__name">{{ c.teacher.fullName }}
                            {% if c.band.label %}<span class="badge badge--accent" title="{{ c.band.hint }}">{{ c.band.label }}</span>{% endif %}
                            {% if c.doublingUp %}<span class="badge badge--warning" title="Ya cubre {{ (assignedHere[c.teacher.id] ?? [])|join(', ') }} a esta hora">Ya cubre {{ c.hereLoad }}</span>{% endif %}
                        </span>
                        <button type="submit" class="btn btn-sm{{ (c.doublingUp or c.slotLoad > 0) ? ' secondary' : '' }}">{{ c.doublingUp ? 'Doblar' : 'Asignar' }}</button>
                    </form>
                {% else %}
                    <p class="muted">Nadie libre en este tramo: todos los profesores de guardia ya cubren un grupo o faltan hoy.</p>
                {% endfor %}

                {# No disponibles: del pool del tramo, quien falta hoy o ya cubre otro grupo y NO se
                   ofrece arriba (en déficit los que doblan sí se ofrecen, así que no se repiten aquí). #}
                {% set ofrecidos = libres|map(c => c.teacher.id) %}
                {% set ocupados = pool|filter(p => (p.absent or p.groups) and p.teacher.id not in ofrecidos) %}
                {% if ocupados is not empty %}
                    <div class="assignsheet__sep"></div>
                    <div class="eyebrow assignsheet__seplabel">No disponibles</div>
                    {% for p in ocupados %}
                        <div class="assignsheet__row is-off">
                            <span class="assignsheet__load">{{ p.load }}</span>
                            <span class="assignsheet__name">{{ p.teacher.fullName }}</span>
                            {% if p.absent %}
                                <span class="badge badge--danger">Ausente</span>
                            {% else %}
                                <span class="badge badge--muted">→ {{ p.groups|join(', ') }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </details>
{% endmacro %}

{% block body %}
    {% import _self as parte %}
    {% set slotActual = slots|filter(s => s.index == slotIndex)|first %}
    {% set slotLabel = slotActual ? slotActual.startsAt|date('H:i', false) ~ '–' ~ slotActual.endsAt|date('H:i', false) : null %}

    <div class="parte">
        {# ---- Cabecera: fecha, título y navegación de día ---- #}
        <header class="page-head">
            <div>
                <p class="eyebrow">{{ dias[date|date('N', false)] }} {{ date|date('d/m/Y', false) }}</p>
                <h1>Parte de guardias</h1>
                <p class="lead">Ausencias del día y reparto de las guardias que las cubren.</p>
            </div>
            <div class="day-nav">
                <a class="day-nav-arrow" href="{{ path('guardia_index', { date: date|date_modify('-1 day')|date('Y-m-d', false), slot: slotIndex }) }}" aria-label="Día anterior">‹</a>
                <form method="get" action="{{ path('guardia_index') }}" class="day-nav-date">
                    <input type="date" name="date" value="{{ date|date('Y-m-d', false) }}" onchange="this.form.submit()" aria-label="Fecha del parte">
                    <input type="hidden" name="slot" value="{{ slotIndex }}">
                    <noscript><button type="submit" class="btn">Ir</button></noscript>
                </form>
                <a class="day-nav-arrow" href="{{ path('guardia_index', { date: date|date_modify('+1 day')|date('Y-m-d', false), slot: slotIndex }) }}" aria-label="Día siguiente">›</a>
                <a class="btn" href="{{ path('guardia_index', { slot: slotIndex }) }}">Hoy</a>
            </div>
        </header>

        {% if slots is empty %}
            <div class="card">
                <div class="empty-state">
                    <h2>No hay horario importado para el curso {{ schoolYear }}</h2>
                    <p>Importa el horario de Peñalara de este curso para poder registrar ausencias y repartir guardias.</p>
                    {% if is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ADMINISTRATION')) %}
                        <p><a class="btn" href="{{ path('admin_timetable_import') }}">Importar horario</a></p>
                    {% endif %}
                </div>
            </div>
        {% else %}
            {# ---- Tramos horarios: el activo en verde, con punto ámbar si le quedan ausencias sin cubrir ---- #}
            <nav class="slotchips" aria-label="Tramo horario">
                {% for slot in slots %}
                    <a class="slotchip {{ slot.index == slotIndex ? 'is-active' }}"
                       href="{{ path('guardia_index', { date: date|date('Y-m-d', false), slot: slot.index }) }}">
                        {{ slot.startsAt|date('H:i', false) }}–{{ slot.endsAt|date('H:i', false) }}
                        {% if slot.index == slotIndex and uncovered > 0 %}<span class="slotchip__dot" aria-hidden="true"></span>{% endif %}
                    </a>
                {% endfor %}
            </nav>

            {# ---- Déficit de personal: se dice, no se disimula ----
               Sale si faltan profesores para las ausencias abiertas (missing) o si YA hay dobletes
               repartidos (doubled). Lo segundo es lo que hace que el aviso sobreviva a «Repartir»:
               después del reparto no queda nada «sin cubrir» pero puede haber gente con dos grupos. #}
            {% if deficit.missing > 0 or deficit.doubled > 0 %}
                <div class="callout callout--warning parte-deficit">
                    <div>
                        <strong>No hay profesores de guardia para todas las ausencias de esta hora.</strong>
                        <p>
                            {{ deficit.uncovered }} ausencia{{ deficit.uncovered == 1 ? '' : 's' }} sin cubrir ·
                            {{ deficit.free }} profesor{{ deficit.free == 1 ? '' : 'es' }} libre{{ deficit.free == 1 ? '' : 's' }}
                            {%- if deficit.doubled > 0 %} · {{ deficit.doubled }} profesor{{ deficit.doubled == 1 ? '' : 'es' }} con {{ deficit.extra }} guardia{{ deficit.extra == 1 ? '' : 's' }} de más{% endif %}
                        </p>
                        <p class="muted">El reparto da varios grupos al mismo profesor cuando no queda nadie libre, empezando por quien menos lleva. Júntalos en un aula grande —así cuenta como una sola guardia— o da de alta apoyo puntual.</p>
                    </div>
                    {% if canWrite %}
                        <div class="parte-deficit__actions">
                            <a class="btn" href="{{ path('guardia_grouping_new', { date: date|date('Y-m-d', false), slot: slotIndex }) }}">Juntar grupos en un aula</a>
                            <a class="btn btn--ghost" href="#pool">Añadir apoyo puntual</a>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# ---- Panel de ausencias del tramo ---- #}
            <section class="parte-panel">
                <div class="parte-panel__head">
                    <div class="parte-panel__titles">
                        <h2 class="parte-panel__title">Ausencias de esta hora</h2>
                        {% if covers is not empty %}
                            <div class="coverage">
                                <span class="badge badge--ok">{{ covered }} cubierta{{ covered == 1 ? '' : 's' }}</span>
                                {% if uncovered > 0 %}<span class="badge badge--warning">{{ uncovered }} sin cubrir</span>{% endif %}
                            </div>
                        {% endif %}
                    </div>
                    {% if canWrite %}
                        <div class="parte-panel__actions">
                            <a class="btn btn--ghost" href="{{ path('guardia_absence_new', { date: date|date('Y-m-d', false) }) }}">+ Apuntar ausencia</a>
                            {# Camino permanente a las agrupaciones (el aviso de déficit también lleva
                               aquí, pero desaparece en cuanto cuadra y hay que poder deshacerlas). #}
                            {% if covers|length > 1 %}
                                <a class="btn btn--ghost" href="{{ path('guardia_grouping_new', { date: date|date('Y-m-d', false), slot: slotIndex }) }}">Juntar grupos</a>
                            {% endif %}
                            {% if uncovered > 0 %}
                                <form method="post" action="{{ path('guardia_auto_assign') }}" class="inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('guardia_auto_assign') }}">
                                    <input type="hidden" name="date" value="{{ date|date('Y-m-d', false) }}">
                                    <input type="hidden" name="slot" value="{{ slotIndex }}">
                                    <button type="submit" class="btn" title="Reparte las guardias pendientes de asignar de este tramo">↻ Repartir</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {# Clase propia, no .empty-state: ese estado vacío es el de "sin horario importado",
                   que es un problema a resolver; esto es la buena noticia de que no falta nadie. #}
                {% if covers is empty %}
                    <div class="parte-empty">
                        <p>Nadie falta a esta hora.</p>
                    </div>
                {% else %}
                    {# Barra de cobertura: sólo aporta en móvil, donde no cabe la tabla entera de un vistazo. #}
                    <div class="coverage-bar" role="img" aria-label="{{ covered }} de {{ covers|length }} ausencias cubiertas">
                        <div class="coverage-bar__track"><div class="coverage-bar__fill" style="width: {{ (covered / covers|length * 100)|round }}%"></div></div>
                        <span class="coverage-bar__count">{{ covered }} / {{ covers|length }}</span>
                    </div>

                    {# ================= MÓVIL: tarjetas, sin cubrir primero (handoff 8a) ================= #}
                    <div class="parte-cards">
                        {% for cover in covers %}
                            {% set sinCubrir = cover.assignedGuardia is null %}
                            <article class="parte-card{{ sinCubrir ? ' is-uncovered' }}{{ cover.notCovered ? ' is-failed' }}">
                                <div class="parte-card__top">
                                    <div class="parte-card__what">
                                        <span class="parte-card__group">{{ cover.groupName ?? '—' }}</span>
                                        {% if cover.grouping %}
                                            <span class="badge badge--accent">→ {{ cover.grouping.roomName }}</span>
                                        {% elseif cover.roomName %}
                                            <span class="parte-card__room">· {{ cover.roomName }}</span>
                                        {% endif %}
                                        <div class="parte-card__absent">Falta: {{ cover.absentTeacher.fullName }}</div>
                                    </div>
                                    {% if cover.notCovered %}
                                        <span class="badge badge--danger">No se cubrió</span>
                                    {% elseif sinCubrir %}
                                        <span class="badge badge--warning">Sin cubrir</span>
                                    {% elseif cover.hasTask %}
                                        <span class="parte-card__task" title="Deja tarea para el grupo">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>
                                        </span>
                                    {% endif %}
                                </div>

                                {% if cover.hasTask %}
                                    <div class="parte-card__taskline">
                                        {% if cover.taskDocumentPath %}
                                            <a class="task-doc" href="{{ path('guardia_task_download', { id: cover.id }) }}">{{ cover.taskDocumentName ?? 'Documento' }}</a>
                                        {% endif %}
                                        {% if cover.taskDescription %}
                                            <span class="parte-card__taskdesc">{{ cover.taskDescription|excerpt(80) }}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {% if sinCubrir and canWrite %}
                                    {{ parte.assign_sheet(cover, candidates, pool, assignedHere, slotLabel) }}
                                {% elseif cover.assignedGuardia %}
                                    {% set aQue = assignedHere[cover.assignedGuardia.id] ?? [] %}
                                    <div class="parte-card__foot">
                                        <span class="parte-card__avatar" aria-hidden="true">{{ cover.assignedGuardia.fullName|initials }}</span>
                                        <span class="parte-card__covers">Cubre <b>{{ cover.assignedGuardia.fullName }}</b></span>
                                        {% if (workUnits[cover.assignedGuardia.id] ?? 1) > 1 and not cover.grouping %}<span class="badge badge--warning" title="Cubre {{ aQue|join(', ') }} a esta hora en sitios distintos">×{{ aQue|length }}</span>{% endif %}
                                        {% if canWrite %}<a class="parte-card__change" href="{{ path('guardia_cover_edit', { id: cover.id }) }}">Cambiar</a>{% endif %}
                                    </div>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>

                    {# ================= ESCRITORIO: tabla refinada (handoff 3a) ================= #}
                    <table class="parte-table">
                        <thead>
                            <tr><th>Grupo · Aula</th><th>Profesor ausente</th><th>Tarea para el grupo</th><th>Guardia asignada</th><th></th></tr>
                            {# El "motivo" junto al ausente es el motivo de la ausencia (privado): solo aquí y en el detalle del coordinador. #}
                        </thead>
                        <tbody>
                            {% for cover in covers %}
                                <tr class="{{ cover.notCovered ? 'is-not-covered' }}{{ cover.assignedGuardia is null ? ' is-uncovered' }}">
                                    <td>
                                        <strong>{{ cover.groupName ?? '—' }}</strong>
                                        {% if cover.grouping %}
                                            {# El aula de la agrupación manda sobre la del horario: es donde
                                               la clase ocurre de verdad, y es lo que hay que leer aquí. #}
                                            <span class="badge badge--accent" title="Junto con otros grupos en {{ cover.grouping.roomName }}">→ {{ cover.grouping.roomName }}</span>
                                        {% elseif cover.roomName %}
                                            <span class="muted mono"> · {{ cover.roomName }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ cover.absentTeacher.fullName }}
                                        {% if cover.absence.reason %}<span class="reason-note muted" title="Motivo (privado): {{ cover.absence.reason }}">· motivo ▾</span>{% endif %}
                                    </td>
                                    <td class="task-cell">
                                        {% if cover.taskDocumentPath %}
                                            <a class="task-doc" href="{{ path('guardia_task_download', { id: cover.id }) }}">📎 {{ cover.taskDocumentName ?? 'Documento' }}</a>
                                        {% endif %}
                                        {% if cover.taskDescription %}
                                            <span class="task-desc" title="{{ cover.taskDescription }}">{{ cover.taskDescription|excerpt(60) }}</span>
                                        {% endif %}
                                        {% if not cover.hasTask %}<span class="muted">Sin tarea</span>{% endif %}
                                    </td>
                                    <td>
                                        {% if cover.notCovered %}
                                            <span class="badge badge--danger">No se cubrió</span>
                                            {% if cover.assignedGuardia %}<span class="muted"> · {{ cover.assignedGuardia.fullName }}</span>{% endif %}
                                        {% elseif cover.assignedGuardia %}
                                            {% set aQue = assignedHere[cover.assignedGuardia.id] ?? [] %}
                                            <span class="parte-who">
                                                <span class="parte-who__avatar" aria-hidden="true">{{ cover.assignedGuardia.fullName|initials }}</span>{{ cover.assignedGuardia.fullName }}
                                            </span>
                                            {# El ámbar señala la fila que hay que resolver: este profesor lleva
                                               más de una guardia a esta hora Y esta clase todavía va aparte. En
                                               una fila ya agrupada el «→ aula» cuenta la historia y el aviso
                                               solo invitaría a agrupar lo que ya está agrupado. #}
                                            {% if (workUnits[cover.assignedGuardia.id] ?? 1) > 1 and not cover.grouping %}
                                                <span class="badge badge--warning" title="Cubre {{ aQue|join(', ') }} a esta hora en sitios distintos: júntalos en un aula y contará como una guardia">Doble guardia</span>
                                            {% endif %}
                                        {% elseif canWrite %}
                                            {# La misma hoja que en móvil: asignar sin salir del parte es
                                               justamente lo que más se usa desde el escritorio. #}
                                            {{ parte.assign_sheet(cover, candidates, pool, assignedHere, slotLabel) }}
                                        {% else %}
                                            <span class="badge badge--warning">Sin asignar</span>
                                        {% endif %}
                                    </td>
                                    <td class="row-actions">
                                        {% if canWrite %}
                                            <a class="link-action" href="{{ path('guardia_cover_edit', { id: cover.id }) }}">Modificar</a>
                                            <form method="post" action="{{ path('guardia_delete', { id: cover.id }) }}" data-confirm="¿Borrar la ausencia de {{ cover.absentTeacher.fullName }} en {{ cover.groupName ?? 'este grupo' }}? Esta línea del parte desaparecerá.">
                                                <input type="hidden" name="_token" value="{{ csrf_token('guardia_delete' ~ cover.id) }}">
                                                <button type="submit" class="link-danger">Borrar</button>
                                            </form>
                                        {% else %}
                                            <a class="link-action" href="{{ path('guardia_cover_show', { id: cover.id }) }}">Ver</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </section>

            {# ---- Quién puede cubrir a esta hora: referencia del reparto (escritorio) ----
               Una sola lista con las tres procedencias (guardia, colaborador y apoyo puntual dado de
               alta a mano para hoy), porque la pregunta del coordinador es una sola: quién hay. #}
            <details class="parte-pool" id="pool"{{ covers is empty ? ' open' : '' }}>
                <summary class="parte-pool__toggle">
                    Profesores disponibles a esta hora
                    <span class="parte-pool__count">{{ pool|length }}</span>
                </summary>
                <div class="parte-pool__body">
                    {% if pool is empty %}
                        <p class="muted">Nadie tiene guardia en el horario para este tramo.</p>
                    {% else %}
                        <p class="parte-pool__lead">Quién puede cubrir según el horario. El número es lo que ya lleva en este tramo: el reparto asigna primero al que menos tiene.</p>
                        <div class="card-grid">
                            {% for p in pool %}
                                <div class="mini-card {{ p.absent ? 'is-absent' : (p.groups ? 'is-busy' : 'is-free') }}">
                                    <div class="mini-card-head">
                                        <strong>{{ p.teacher.fullName }}</strong>
                                        {% if p.band.label %}<span class="badge badge--accent" title="{{ p.band.hint }}">{{ p.band.label }}</span>{% endif %}
                                    </div>
                                    {% if p.note %}<p class="mini-card-note">{{ p.note }}</p>{% endif %}
                                    <div class="mini-card-status">
                                        {% if p.absent %}
                                            <span class="badge badge--danger">Ausente</span>
                                        {% elseif p.groups|length > 1 %}
                                            {# Ámbar solo si son sitios distintos; ya juntos en un aula es una guardia. #}
                                            <span class="badge {{ (workUnits[p.teacher.id] ?? 1) > 1 ? 'badge--warning' : 'badge--muted' }}" title="Cubre {{ p.groups|join(', ') }} a esta hora">→ {{ p.groups|length }} grupos</span>
                                        {% elseif p.groups %}
                                            <span class="badge badge--muted">→ {{ p.groups|join(', ') }}</span>
                                        {% else %}
                                            <span class="badge badge--ok">Disponible</span>
                                        {% endif %}
                                        <span class="load-count" title="{{ p.load }} guardia(s) en este tramo. El reparto elige primero al que menos tiene.">{{ p.load }}</span>
                                        {% if p.supportId and canWrite %}
                                            <form method="post" action="{{ path('guardia_support_remove', { id: p.supportId }) }}" data-confirm="¿Quitar a {{ p.teacher.fullName }} del apoyo de esta hora? Las guardias que ya tenga asignadas se mantienen.">
                                                <input type="hidden" name="_token" value="{{ csrf_token('guardia_support_remove' ~ p.supportId) }}">
                                                <button type="submit" class="link-danger">Quitar</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# ---- Alta de apoyo puntual ----
                       Aquí y no en el aviso de déficit: el aviso desaparece cuando cuadra, y esto se
                       prepara antes (se sabe con días de antelación que un viernes va justo). #}
                    {% if canWrite %}
                        <details class="support-add">
                            <summary class="support-add__toggle">+ Añadir apoyo puntual a esta hora</summary>
                            <form method="post" action="{{ path('guardia_support_add') }}" class="support-add__form">
                                <input type="hidden" name="_token" value="{{ csrf_token('guardia_support_add') }}">
                                <input type="hidden" name="date" value="{{ date|date('Y-m-d', false) }}">
                                <input type="hidden" name="slot" value="{{ slotIndex }}">
                                <p class="support-add__lead">Para compañeros que hoy están libres a esta hora aunque su horario diga otra cosa (2º de Bachillerato o CFGB ya han terminado las clases). Vale solo para este día y esta hora.</p>
                                <label class="field-label" for="support-teacher">Profesor</label>
                                <select id="support-teacher" name="teacher" required>
                                    <option value="">— Elige —</option>
                                    {% for u in supportPicker %}
                                        {% set daClase = teachingHere[u.id] ?? [] %}
                                        <option value="{{ u.id }}">{{ u.fullName }}{% if daClase %} — según el horario da clase a {{ daClase|join(', ') }}{% endif %}</option>
                                    {% endfor %}
                                </select>
                                <label class="field-label" for="support-note">Por qué está libre <span class="muted">(opcional)</span></label>
                                <input type="text" id="support-note" name="note" maxlength="255" placeholder="2º de Bach ha terminado las clases">
                                <button type="submit" class="btn">Añadir como apoyo</button>
                            </form>
                        </details>
                    {% endif %}
                </div>
            </details>
        {% endif %}
    </div>
{% endblock %}

{% extends 'app_shell.html.twig' %}

{% set canWrite = is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::GUARDIAS')) %}
{% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}

{% block title %}Parte de guardias{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Guardias<span class="sep">/</span>Parte del día{% endblock %}

{# El icono de «repartir»: dos flechas en círculo. Aquí y no suelto por la plantilla porque la misma
   acción aparece en el ancla y dentro de la hoja de candidatos. #}
{% macro icon_shuffle() %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4v6h6"/><path d="M20 20v-6h-6"/><path d="M20 9A8 8 0 0 0 6 6L4 8M4 15a8 8 0 0 0 14 3l2-2"/></svg>
{% endmacro %}

{% macro icon_doc() %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>
{% endmacro %}

{#
   La hoja para asignar una ausencia concreta: candidatos que el reparto elegiría, primero quien menos
   carga lleva, y debajo quién NO puede cubrir y por qué. Se abre con <details> para no depender de JS.
   `libres` son los GuardiaCandidate ya priorizados por el scheduler.

   En déficit la lista incluye a compañeros que YA cubren un grupo a esa hora (hereLoad > 0): salen al
   final, marcados, y el botón dice «Doblar» en vez de «Asignar» — que quede claro que asignarlos es
   ponerles un segundo grupo, no darles trabajo nuevo.

   Lleva dentro «Repartir automáticamente» (handoff 22c): quien abre la hoja para un hueco suele querer
   resolver la hora entera, y tenerlo aquí ahorra volver arriba.
#}
{% macro assign_sheet(cover, libres, pool, assignedHere, slotLabel, uncovered) %}
    {% import _self as ico %}
    <details class="assignsheet">
        {# «profesor» sobra en la tabla de escritorio, donde la columna ya se llama «Cubre»; en la tarjeta de
           móvil el botón va a ancho completo y sin él quedaría un verbo suelto. #}
        <summary class="assignsheet__toggle">Asignar<span class="assignsheet__toggleword"> profesor</span></summary>
        <div class="assignsheet__panel">
            <div class="assignsheet__grip" aria-hidden="true"></div>
            <div class="assignsheet__head">
                <div class="eyebrow">Asignar guardia</div>
                <h3 class="assignsheet__title">{{ cover.groupName ?? 'Sin grupo' }}{% if cover.roomName %} · {{ cover.roomName }}{% endif %}
                    {% if slotLabel %}<span class="assignsheet__when">· {{ slotLabel }}</span>{% endif %}
                </h3>
                <p class="assignsheet__sub">Falta {{ cover.absentTeacher.fullName }} · primero quien menos lleva</p>
                {% if uncovered > 1 %}
                    <form method="post" action="{{ path('guardia_auto_assign') }}" class="inline-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('guardia_auto_assign') }}">
                        <input type="hidden" name="date" value="{{ cover.date|date('Y-m-d', false) }}">
                        <input type="hidden" name="slot" value="{{ cover.slotIndex }}">
                        <button type="submit" class="assignsheet__auto">{{ ico.icon_shuffle() }} Repartir las {{ uncovered }} de esta hora</button>
                    </form>
                {% endif %}
            </div>

            <div class="assignsheet__list">
                {% for c in libres %}
                    <form method="post" action="{{ path('guardia_cover_assign', { id: cover.id }) }}" class="assignsheet__row{{ c.doublingUp ? ' is-doubling' }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('guardia_cover_assign' ~ cover.id) }}">
                        <input type="hidden" name="guardia" value="{{ c.teacher.id }}">
                        <span class="assignsheet__load" title="{{ c.slotLoad }} guardia(s) en este tramo">{{ c.slotLoad }}</span>
                        <span class="assignsheet__name">{{ c.teacher.fullName }}
                            {% if c.band.label %}<span class="badge badge--accent" title="{{ c.band.hint }}">{{ c.band.label }}</span>{% endif %}
                            {% if c.doublingUp %}<span class="badge badge--warning" title="Ya cubre {{ (assignedHere[c.teacher.id] ?? [])|join(', ') }} a esta hora">Ya lleva {{ c.hereLoad }} guardia{{ c.hereLoad == 1 ? '' : 's' }}</span>{% endif %}
                        </span>
                        {# Naranja pleno solo para quien está a cero: es a quien hay que pulsar. Los demás,
                           en secundario, para que doblar o cargar más a alguien no se haga por inercia. #}
                        <button type="submit" class="btn btn-sm{{ (c.doublingUp or c.slotLoad > 0) ? ' secondary' : '' }}">{{ c.doublingUp ? 'Doblar' : 'Asignar' }}</button>
                    </form>
                {% else %}
                    <p class="muted">Nadie libre en este tramo: todos los profesores de guardia ya cubren un grupo o faltan hoy.</p>
                {% endfor %}

                {# No disponibles: del pool del tramo, quien falta hoy o ya cubre otro grupo y NO se
                   ofrece arriba (en déficit los que doblan sí se ofrecen, así que no se repiten aquí). #}
                {% set ofrecidos = libres|map(c => c.teacher.id) %}
                {% set ocupados = pool|filter(p => (p.absent or p.groups) and p.teacher.id not in ofrecidos) %}
                {% if ocupados is not empty %}
                    <div class="assignsheet__sep"></div>
                    <div class="eyebrow assignsheet__seplabel">No disponibles</div>
                    {% for p in ocupados %}
                        <div class="assignsheet__row is-off">
                            <span class="assignsheet__load">{{ p.load }}</span>
                            <span class="assignsheet__name">{{ p.teacher.fullName }}</span>
                            {% if p.absent %}
                                <span class="badge badge--danger">Ausente</span>
                            {% else %}
                                <span class="badge badge--muted">→ {{ p.groups|join(', ') }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </details>
{% endmacro %}

{#
   Coger tarea del banco sin salir del parte, para una línea que no tiene ninguna: "Del banco" saca una
   al azar del nivel que deduce el grupo (un clic, que es el gesto de la mañana de guardias) y "Elegir…"
   abre el banco filtrado para esa guardia. Vuelve al parte, no al detalle: el coordinador está
   repasando la hora entera.
#}
{% macro bank_pick(cover, canWrite) %}
    {% if canWrite %}
        <span class="bank-pick">
            <form method="post" action="{{ path('guardia_bank_apply', { cover: cover.id }) }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('guardia_bank_apply' ~ cover.id) }}">
                <input type="hidden" name="volver" value="parte">
                <button type="submit" class="link-action" title="Coge una tarea al azar del banco para el nivel de este grupo">Del banco</button>
            </form>
            <a class="link-action" href="{{ path('guardia_bank_index', { para: cover.id }) }}">Elegir…</a>
        </span>
    {% endif %}
{% endmacro %}

{% block body %}
    {% import _self as parte %}
    {% set slotActual = slots|filter(s => s.index == slotIndex)|first %}
    {% set slotLabel = slotActual ? slotActual.startsAt|date('H:i', false) ~ '–' ~ slotActual.endsAt|date('H:i', false) : null %}
    {% set esHoy = date|date('Y-m-d', false) == 'now'|date('Y-m-d', false) %}

    <div class="parte">
        {# ---- Barra ancla: el día, cómo va y las acciones de la hora ----------------------
           A sangre y en tostado profundo, el único bloque oscuro de la pantalla: el día y la cobertura
           son el marco dentro del que se lee todo lo demás, y así el resto queda en superficie clara.
           Las acciones globales viven SOLO aquí (antes estaban repartidas entre la cabecera y el panel,
           y ninguna de las dos parecía la principal). #}
        <header class="parte-anchor">
            <div class="parte-anchor__what">
                <p class="parte-anchor__eyebrow"><span class="parte-anchor__dot" aria-hidden="true"></span>Parte del día</p>
                <div class="parte-anchor__row">
                    <span class="parte-anchor__day">{{ dias[date|date('N', false)] }} {{ date|date('d/m', false) }}</span>
                    <span class="parte-anchor__sum">
                        {% if dayAbsences > 0 %}
                            {# Sin «hoy»: la pantalla también se usa para cuadrar otros días, y el parte de
                               marzo no puede decir «hoy» estando en julio. #}
                            <b>{{ dayAbsences }} ausencia{{ dayAbsences == 1 ? '' : 's' }}</b> en el día
                            {%- if uncovered > 0 %} · {{ uncovered }} sin cubrir a esta hora{% endif %}
                        {% else %}
                            No hay ausencias apuntadas
                        {% endif %}
                    </span>
                </div>
                {# La cobertura del tramo, siempre a la vista: es la pregunta que trae aquí al coordinador. #}
                {% if covers is not empty %}
                    <div class="parte-anchor__coverage">
                        <div class="coverage-bar" role="img" aria-label="{{ covered }} de {{ covers|length }} ausencias cubiertas a esta hora">
                            <div class="coverage-bar__track"><div class="coverage-bar__fill" style="width: {{ (covered / covers|length * 100)|round }}%"></div></div>
                            <span class="coverage-bar__count">{{ covered }} / {{ covers|length }} cubiertas</span>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="parte-anchor__actions">
                <div class="parte-anchor__nav">
                    <a class="parte-anchor__arrow" href="{{ path('guardia_index', { date: date|date_modify('-1 day')|date('Y-m-d', false), slot: slotIndex }) }}" aria-label="Día anterior">‹</a>
                    <form method="get" action="{{ path('guardia_index') }}" class="parte-anchor__date">
                        <input type="date" name="date" value="{{ date|date('Y-m-d', false) }}" onchange="this.form.submit()" aria-label="Fecha del parte">
                        <input type="hidden" name="slot" value="{{ slotIndex }}">
                        <noscript><button type="submit" class="parte-anchor__ghost">Ir</button></noscript>
                    </form>
                    <a class="parte-anchor__arrow" href="{{ path('guardia_index', { date: date|date_modify('+1 day')|date('Y-m-d', false), slot: slotIndex }) }}" aria-label="Día siguiente">›</a>
                </div>
                {% if not esHoy %}
                    <a class="parte-anchor__today" href="{{ path('guardia_index', { slot: slotIndex }) }}">Hoy</a>
                {% endif %}
                {% if canWrite %}
                    <a class="parte-anchor__ghost" href="{{ path('guardia_absence_new', { date: date|date('Y-m-d', false) }) }}">＋ Apuntar ausencia</a>
                    {% if uncovered > 0 %}
                        <form method="post" action="{{ path('guardia_auto_assign') }}" class="inline-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('guardia_auto_assign') }}">
                            <input type="hidden" name="date" value="{{ date|date('Y-m-d', false) }}">
                            <input type="hidden" name="slot" value="{{ slotIndex }}">
                            <button type="submit" class="btn parte-anchor__go" title="Reparte las guardias pendientes de asignar de este tramo">{# Sin espacio antes del span: el botón es flex y su gap ya separa las dos palabras (con espacio salían dos). #}
                            {{ parte.icon_shuffle() }} Repartir<span class="parte-anchor__goword">automáticamente</span></button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        </header>

        {% if slots is empty %}
            <div class="card">
                <div class="empty-state">
                    <h2>No hay horario importado para el curso {{ schoolYear }}</h2>
                    <p>Importa el horario de Peñalara de este curso para poder registrar ausencias y repartir guardias.</p>
                    {% if is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ADMINISTRATION')) %}
                        <p><a class="btn" href="{{ path('admin_timetable_import') }}">Importar horario</a></p>
                    {% endif %}
                </div>
            </div>
        {% else %}
            {# ---- Tramos horarios ----
               El activo en naranja pleno; los que TODAVÍA tienen huecos llevan un punto de aviso, sea cual
               sea el tramo abierto: el hueco de las 09:20 no espera a que alguien pulse ese chip. #}
            <nav class="parte-slots" aria-label="Tramo horario">
                <span class="parte-slots__label">Tramo</span>
                <div class="slotchips">
                    {% for slot in slots %}
                        {% set huecos = (slotCoverage[slot.index] ?? { uncovered: 0 }).uncovered %}
                        {# El punto avisa de los huecos de los OTROS tramos: del tramo abierto ya lo dice la
                           barra de cobertura del ancla, y sobre el chip relleno no se distinguiría. #}
                        {% set aviso = huecos > 0 and slot.index != slotIndex %}
                        <a class="slotchip {{ slot.index == slotIndex ? 'is-active' }}"
                           href="{{ path('guardia_index', { date: date|date('Y-m-d', false), slot: slot.index }) }}"
                           {% if aviso %}title="{{ huecos }} sin cubrir a esta hora"{% endif %}>
                            {{ slot.startsAt|date('H:i', false) }}–{{ slot.endsAt|date('H:i', false) }}
                            {% if aviso %}<span class="slotchip__dot" aria-hidden="true"></span>{% endif %}
                        </a>
                    {% endfor %}
                </div>
            </nav>

            {# ---- Déficit de personal: se dice, no se disimula ----
               Sale si faltan profesores para las ausencias abiertas (missing) o si YA hay dobletes
               repartidos (doubled). Lo segundo es lo que hace que el aviso sobreviva a «Repartir»:
               después del reparto no queda nada «sin cubrir» pero puede haber gente con dos grupos. #}
            {% if deficit.missing > 0 or deficit.doubled > 0 %}
                <div class="callout callout--warning parte-deficit">
                    <div>
                        <strong>No hay profesores de guardia para todas las ausencias de esta hora.</strong>
                        <p>
                            {{ deficit.uncovered }} ausencia{{ deficit.uncovered == 1 ? '' : 's' }} sin cubrir ·
                            {{ deficit.free }} profesor{{ deficit.free == 1 ? '' : 'es' }} libre{{ deficit.free == 1 ? '' : 's' }}
                            {%- if deficit.doubled > 0 %} · {{ deficit.doubled }} profesor{{ deficit.doubled == 1 ? '' : 'es' }} con {{ deficit.extra }} guardia{{ deficit.extra == 1 ? '' : 's' }} de más{% endif %}
                        </p>
                        <p class="muted">El reparto da varios grupos al mismo profesor cuando no queda nadie libre, empezando por quien menos lleva. Júntalos en un aula grande —así cuenta como una sola guardia— o da de alta apoyo puntual.</p>
                    </div>
                    {% if canWrite %}
                        <div class="parte-deficit__actions">
                            <a class="btn" href="{{ path('guardia_grouping_new', { date: date|date('Y-m-d', false), slot: slotIndex }) }}">Juntar grupos en un aula</a>
                            <a class="btn btn--ghost" href="#pool">Añadir apoyo puntual</a>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# ---- Todo cubierto: la buena noticia se dice una vez y en verde ----
               Verde, no naranja: el naranja de esta pantalla significa «esto te reclama». #}
            {% if covers is not empty and uncovered == 0 %}
                <p class="parte-done">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    Todo cubierto a esta hora · {{ covered }} de {{ covers|length }}
                </p>
            {% endif %}

            {# ---- Panel de ausencias del tramo ---- #}
            <section class="parte-panel">
                {# Clase propia, no .empty-state: ese estado vacío es el de "sin horario importado",
                   que es un problema a resolver; esto es la buena noticia de que no falta nadie. #}
                {% if covers is empty %}
                    <div class="parte-empty">
                        <p><b>Nadie falta a esta hora.</b></p>
                        <p class="muted">{{ dias[date|date('N', false)] }} {{ date|date('d/m/Y', false) }}{% if slotLabel %} · {{ slotLabel }}{% endif %}. Si sabes de una ausencia, apúntala y se reparte la guardia.</p>
                        {% if canWrite %}
                            <a class="btn btn--ghost" href="{{ path('guardia_absence_new', { date: date|date('Y-m-d', false) }) }}">＋ Apuntar ausencia</a>
                        {% endif %}
                    </div>
                {% else %}
                    {# Cabecera de la lista, solo en móvil: en escritorio la cabecera de la tabla ya dice
                       qué es cada columna, y repetir el rótulo sobraba. #}
                    <div class="parte-listhead">
                        <span class="parte-listhead__count">{{ covers|length }} ausencia{{ covers|length == 1 ? '' : 's' }}{% if slotLabel %} · {{ slotLabel }}{% endif %}</span>
                        {% if canWrite and covers|length > 1 %}
                            <a class="parte-listhead__link" href="{{ path('guardia_grouping_new', { date: date|date('Y-m-d', false), slot: slotIndex }) }}">Juntar grupos</a>
                        {% endif %}
                    </div>

                    {# ================= MÓVIL: tarjetas, sin cubrir primero ================= #}
                    <div class="parte-cards">
                        {% for cover in covers %}
                            {% set sinCubrir = cover.assignedGuardia is null %}
                            <article class="parte-card{{ sinCubrir ? ' is-uncovered' }}{{ cover.notCovered ? ' is-failed' }}">
                                <div class="parte-card__top">
                                    <div class="parte-card__what">
                                        <span class="parte-card__group">{{ cover.groupName ?? '—' }}</span>
                                        {% if cover.grouping %}
                                            <span class="badge badge--accent">→ {{ cover.grouping.roomName }}</span>
                                        {% elseif cover.roomName %}
                                            <span class="parte-card__room">· {{ cover.roomName }}</span>
                                        {% endif %}
                                        <div class="parte-card__absent">Falta: {{ cover.absentTeacher.fullName }}</div>
                                    </div>
                                    {# Lo que contó quien cubrió: la coordinación resuelve desde esta pantalla, así
                                       que el aviso tiene que verse aquí y no solo en la ficha de la guardia. #}
                                    {% if cover.hasIncident %}
                                        <span class="badge badge--warning" title="{{ cover.incidentNote }}">Incidencia</span>
                                    {% endif %}
                                    {% if cover.notCovered %}
                                        <span class="badge badge--danger">No se cubrió</span>
                                    {% elseif sinCubrir %}
                                        <span class="parte-chip-gap">Sin cubrir</span>
                                    {% elseif cover.hasTask %}
                                        <span class="parte-card__task" title="Deja tarea para el grupo">{{ parte.icon_doc() }}</span>
                                    {% else %}
                                        <span class="parte-card__notask">sin tarea</span>
                                    {% endif %}
                                </div>

                                {% if cover.hasTask or canWrite %}
                                <div class="parte-card__taskline">
                                    {% if cover.taskDocumentPath %}
                                        <a class="task-doc" href="{{ path('guardia_task_download', { id: cover.id }) }}">{{ cover.taskDocumentName ?? 'Documento' }}</a>
                                    {% endif %}
                                    {% if cover.taskDescription %}
                                        <span class="parte-card__taskdesc">{{ cover.taskDescription|excerpt(80) }}</span>
                                    {% endif %}
                                    {% if cover.hasBankTask %}
                                        <span class="parte-card__taskdesc">Ficha del banco · {{ cover.bankItem.title|excerpt(60) }}</span>
                                    {% endif %}
                                    {% if not cover.hasTask %}
                                        {{ parte.bank_pick(cover, canWrite) }}
                                    {% endif %}
                                </div>
                                {% endif %}

                                {% if sinCubrir and canWrite %}
                                    {{ parte.assign_sheet(cover, candidates, pool, assignedHere, slotLabel, uncovered) }}
                                {% elseif cover.assignedGuardia %}
                                    <div class="parte-card__foot">
                                        <span class="parte-card__avatar" aria-hidden="true">{{ cover.assignedGuardia.fullName|initials }}</span>
                                        <span class="parte-card__covers">Cubre <b>{{ cover.assignedGuardia.fullName }}</b></span>
                                        {% if (workUnits[cover.assignedGuardia.id] ?? 1) > 1 and not cover.grouping %}<span class="badge badge--warning" title="Lleva {{ workUnits[cover.assignedGuardia.id] }} guardias a esta hora en sitios distintos">×{{ workUnits[cover.assignedGuardia.id] }}</span>{% endif %}
                                        {# Mismo verbo que en la tabla de escritorio: dos nombres para la misma pantalla despistaban. #}
                                        {% if canWrite %}<a class="parte-card__change" href="{{ path('guardia_cover_edit', { id: cover.id }) }}">Cambiar</a>{% endif %}
                                    </div>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>

                    {# ================= ESCRITORIO: la tabla ================= #}
                    <table class="parte-table">
                        <thead>
                            <tr><th>Grupo · Aula</th><th>Profesor ausente</th><th>Tarea para el grupo</th><th>Cubre</th><th></th></tr>
                            {# El "motivo" junto al ausente es el motivo de la ausencia (privado): solo aquí y en el detalle del coordinador. #}
                        </thead>
                        <tbody>
                            {% for cover in covers %}
                                <tr class="{{ cover.notCovered ? 'is-not-covered' }}{{ cover.assignedGuardia is null ? ' is-uncovered' }}">
                                    <td>
                                        <strong>{{ cover.groupName ?? '—' }}</strong>
                                        {% if cover.grouping %}
                                            {# El aula de la agrupación manda sobre la del horario: es donde
                                               la clase ocurre de verdad, y es lo que hay que leer aquí. #}
                                            <span class="badge badge--accent" title="Junto con otros grupos en {{ cover.grouping.roomName }}">→ {{ cover.grouping.roomName }}</span>
                                        {% elseif cover.roomName %}
                                            <span class="parte-room">{{ cover.roomName }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ cover.absentTeacher.fullName }}
                                        {% if cover.absence.reason %}<span class="reason-note muted" title="Motivo (privado): {{ cover.absence.reason }}">· motivo ▾</span>{% endif %}
                                    </td>
                                    <td class="task-cell">
                                        {% if cover.hasTask %}
                                            <span class="parte-task">
                                                <span class="parte-task__icon">{{ parte.icon_doc() }}</span>
                                                <span class="parte-task__text">
                                                    {% if cover.taskDocumentPath %}
                                                        <a class="task-doc" href="{{ path('guardia_task_download', { id: cover.id }) }}">{{ cover.taskDocumentName ?? 'Documento' }}</a>
                                                    {% endif %}
                                                    {# La del banco se distingue de la que dejó el profesor: no es su trabajo, es de repuesto. #}
                                                    {% if cover.hasBankTask %}Ficha del banco · {{ cover.bankItem.title|excerpt(48) }}{% endif %}
                                                    {% if cover.taskDescription %}<span title="{{ cover.taskDescription }}">{{ cover.taskDescription|excerpt(60) }}</span>{% endif %}
                                                </span>
                                            </span>
                                        {% else %}
                                            <span class="parte-notask">Sin tarea</span>
                                            {{ parte.bank_pick(cover, canWrite) }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if cover.hasIncident %}
                                            <span class="badge badge--warning" title="{{ cover.incidentNote }}">Incidencia</span>
                                        {% endif %}
                                        {% if cover.notCovered %}
                                            <span class="badge badge--danger">No se cubrió</span>
                                            {% if cover.assignedGuardia %}<span class="muted"> · {{ cover.assignedGuardia.fullName }}</span>{% endif %}
                                        {% elseif cover.assignedGuardia %}
                                            <span class="parte-who">
                                                <span class="parte-who__avatar" aria-hidden="true">{{ cover.assignedGuardia.fullName|initials }}</span>{{ cover.assignedGuardia.fullName }}
                                            </span>
                                            {# El ámbar señala la fila que hay que resolver: este profesor lleva
                                               más de una guardia a esta hora Y esta clase todavía va aparte. En
                                               una fila ya agrupada el «→ aula» cuenta la historia y el aviso
                                               solo invitaría a agrupar lo que ya está agrupado. #}
                                            {% if (workUnits[cover.assignedGuardia.id] ?? 1) > 1 and not cover.grouping %}
                                                {# «{{ n }} guardias», no la lista de grupos: si algunos ya van
                                                   juntos, enumerarlos como «sitios distintos» sería falso. #}
                                                <span class="badge badge--warning" title="Lleva {{ workUnits[cover.assignedGuardia.id] }} guardias a esta hora en sitios distintos; esta clase va aparte. Júntala con otra en un aula y contarán como una.">Doble guardia</span>
                                            {% endif %}
                                        {% else %}
                                            {# El estado se dice con palabras, no solo con el tinte de la fila:
                                               quien lee en blanco y negro (o imprime el parte) tiene que verlo. #}
                                            <span class="parte-gap"><span class="parte-gap__dot" aria-hidden="true"></span>Sin cubrir</span>
                                        {% endif %}
                                    </td>
                                    <td class="row-actions">
                                        {# El envoltorio no es decorativo: un <td> con display:flex deja de ser
                                           celda y rompe la rejilla de la tabla (bordes cortados y columnas
                                           desalineadas). El flex va aquí dentro. #}
                                        <div class="row-actions__inner">
                                            {% if canWrite %}
                                                {% if cover.assignedGuardia is null and not cover.notCovered %}
                                                    {# La misma hoja que en móvil: asignar sin salir del parte es
                                                       justamente lo que más se usa desde el escritorio. #}
                                                    {{ parte.assign_sheet(cover, candidates, pool, assignedHere, slotLabel, uncovered) }}
                                                {% else %}
                                                    <a class="link-action" href="{{ path('guardia_cover_edit', { id: cover.id }) }}">Cambiar</a>
                                                {% endif %}
                                                <form method="post" action="{{ path('guardia_delete', { id: cover.id }) }}" data-confirm="¿Borrar la ausencia de {{ cover.absentTeacher.fullName }} en {{ cover.groupName ?? 'este grupo' }}? Esta línea del parte desaparecerá.">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('guardia_delete' ~ cover.id) }}">
                                                    <button type="submit" class="link-quiet">Borrar</button>
                                                </form>
                                            {% else %}
                                                <a class="link-action" href="{{ path('guardia_cover_show', { id: cover.id }) }}">Ver</a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </section>

            {# ---- Profesorado de guardia a esta hora: la referencia del reparto ----
               Una sola lista con las tres procedencias (guardia, colaborador y apoyo puntual dado de
               alta a mano para hoy), porque la pregunta del coordinador es una sola: quién hay. Abierta
               por defecto: es lo que se mira ANTES de asignar, no un anexo. #}
            <details class="parte-pool" id="pool" open>
                <summary class="parte-pool__toggle">
                    <span class="parte-pool__label">Profesorado de guardia{% if slotLabel %} · {{ slotLabel }}{% endif %}</span>
                    <span class="parte-pool__count">{{ pool|length }}</span>
                </summary>
                <div class="parte-pool__body">
                    {% if pool is empty %}
                        <p class="muted">Nadie tiene guardia en el horario para este tramo.</p>
                    {% else %}
                        <div class="parte-pool__meta">
                            <p class="parte-pool__lead">Ordenado como reparte la máquina: primero quien menos guardias lleva a esta hora.</p>
                            <span class="parte-pool__legend"><span class="load-count">n</span> guardias a esta hora este curso</span>
                        </div>
                        <div class="duty-grid">
                            {% for p in pool %}
                                {% set libre = not p.absent and not p.groups %}
                                <div class="duty-card {{ libre ? 'is-free' : 'is-off' }}">
                                    <div class="duty-card__what">
                                        <div class="duty-card__name">{{ p.teacher.fullName }}</div>
                                        <div class="duty-card__tags">
                                            {% if p.absent %}
                                                <span class="duty-tag duty-tag--absent">Ausente</span>
                                            {% elseif p.groups|length > 1 %}
                                                {# Aviso solo si son sitios distintos; ya juntos en un aula es una guardia. #}
                                                <span class="duty-tag {{ (workUnits[p.teacher.id] ?? 1) > 1 ? 'duty-tag--over' : '' }}" title="Cubre {{ p.groups|join(', ') }} a esta hora">→ {{ p.groups|length }} grupos</span>
                                            {% elseif p.groups %}
                                                <span class="duty-tag" title="Cubre {{ p.groups|join(', ') }} a esta hora">→ {{ p.groups|join(', ') }}</span>
                                            {% else %}
                                                <span class="duty-tag duty-tag--free">Libre</span>
                                            {% endif %}
                                            {% if p.band.label %}<span class="duty-tag" title="{{ p.band.hint }}">{{ p.band.label }}</span>{% endif %}
                                        </div>
                                        {% if p.note %}<p class="duty-card__note">{{ p.note }}</p>{% endif %}
                                    </div>
                                    <div class="duty-card__side">
                                        <span class="load-count{{ p.load == 0 and libre ? ' is-zero' : '' }}" title="{{ p.load }} guardia(s) a esta hora este curso. El reparto elige primero al que menos tiene.">{{ p.load }}</span>
                                        {% if p.supportId and canWrite %}
                                            <form method="post" action="{{ path('guardia_support_remove', { id: p.supportId }) }}" data-confirm="¿Quitar a {{ p.teacher.fullName }} del apoyo de esta hora? Las guardias que ya tenga asignadas se mantienen.">
                                                <input type="hidden" name="_token" value="{{ csrf_token('guardia_support_remove' ~ p.supportId) }}">
                                                <button type="submit" class="link-quiet">Quitar</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# ---- Alta de apoyo puntual ----
                       Aquí y no en el aviso de déficit: el aviso desaparece cuando cuadra, y esto se
                       prepara antes (se sabe con días de antelación que un viernes va justo). #}
                    {% if canWrite %}
                        <details class="support-add">
                            <summary class="support-add__toggle">+ Añadir apoyo puntual a esta hora</summary>
                            <form method="post" action="{{ path('guardia_support_add') }}" class="support-add__form">
                                <input type="hidden" name="_token" value="{{ csrf_token('guardia_support_add') }}">
                                <input type="hidden" name="date" value="{{ date|date('Y-m-d', false) }}">
                                <input type="hidden" name="slot" value="{{ slotIndex }}">
                                <p class="support-add__lead">Para compañeros que hoy están libres a esta hora aunque su horario diga otra cosa (2º de Bachillerato o CFGB ya han terminado las clases). Vale solo para este día y esta hora.</p>
                                <label class="field-label" for="support-teacher">Profesor</label>
                                <select id="support-teacher" name="teacher" required>
                                    <option value="">— Elige —</option>
                                    {% for u in supportPicker %}
                                        {% set daClase = teachingHere[u.id] ?? [] %}
                                        <option value="{{ u.id }}">{{ u.fullName }}{% if daClase %} — según el horario da clase a {{ daClase|join(', ') }}{% endif %}</option>
                                    {% endfor %}
                                </select>
                                <label class="field-label" for="support-note">Por qué está libre <span class="muted">(opcional)</span></label>
                                <input type="text" id="support-note" name="note" maxlength="255" placeholder="2º de Bach ha terminado las clases">
                                <button type="submit" class="btn">Añadir como apoyo</button>
                            </form>
                        </details>
                    {% endif %}
                </div>
            </details>
        {% endif %}
    </div>
{% endblock %}

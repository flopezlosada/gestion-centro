{% extends 'app_shell.html.twig' %}

{% block title %}{{ task.title }} · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('task_index') }}">Tareas</a><span class="sep">/</span>{{ task.title }}{% endblock %}

{# Pantalla empujada: sin barra de pestañas; barra de volver arriba y barra de acciones abajo. #}
{% block bottomnav %}{% endblock %}

{% block body %}
    {# Una sola definición de "fuera de plazo", la de la entidad: aquí estaba reescrita a mano. #}
    {% set overdue = task.isOverdueOn(date()) %}
    {% set responsibleRole = task.responsibility ? task.responsibility.role.name : (task.assignedRole ? task.assignedRole.name : null) %}
    {% set who = task.responsibleForDisplay %}
    {% set canValidate = 'validate' in actions %}
    {% set pill = {
        'pending':   {'cls': 'is-pending', 'label': 'Pendiente'},
        'submitted': {'cls': 'is-amber',   'label': canValidate ? 'Entregada · espera tu OK' : 'Entregada'},
        'in_review': {'cls': 'is-review',  'label': 'En revisión'},
        'validated': {'cls': 'is-success', 'label': '✓ Finalizada'},
        'cancelled': {'cls': 'is-muted',   'label': 'Cancelada'},
    }[task.status]|default({'cls': 'is-pending', 'label': task.status}) %}

    {# Barra de volver (solo móvil; en escritorio manda el breadcrumb de la topbar). #}
    <div class="backbar">
        <a class="backbar__back" href="{{ path('task_index') }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>Tareas
        </a>
        {% if canManage %}<a class="backbar__edit" href="{{ path('task_edit', { id: task.id }) }}">Editar</a>{% endif %}
    </div>

    <div class="detail-cols">
      <div class="detail-main">
        <span class="status-pill task-pill--{{ pill.cls }}">{{ pill.label }}</span>
        {% if not task.mandatory %}<span class="status-pill task-pill--is-muted">Voluntaria</span>{% endif %}
        <h1 class="task-detail__title">{{ task.title }}</h1>

        {# Ficha 2×2 con lo esencial #}
        <dl class="meta-grid">
            <div class="meta-grid__cell">
                <dt>Fecha límite</dt>
                <dd class="mono{{ overdue ? ' is-overdue' }}">{{ task.dueDate|date('d/m/Y') }}</dd>
            </div>
            <div class="meta-grid__cell">
                <dt>Unidad</dt>
                <dd>{{ task.unit ? task.unit.name : '—' }}</dd>
            </div>
            <div class="meta-grid__cell">
                <dt>Rol</dt>
                <dd>{{ responsibleRole ?? '—' }}</dd>
            </div>
            <div class="meta-grid__cell">
                <dt>Responsable</dt>
                <dd>{{ who ? who.fullName : '—' }}{% if task.delegatedTo %} · delegada{% endif %}</dd>
            </div>
        </dl>

        {# Instrucciones #}
        <div class="detail-block">
            <div class="detail-block__label">Instrucciones</div>
            {% if task.description %}<p class="detail-prose">{{ task.description|nl2br }}</p>{% else %}<p class="muted">Esta tarea no tiene descripción.</p>{% endif %}
        </div>

        {# Aviso: qué hay que entregar (mientras no se ha entregado: pendiente o devuelta para revisar) #}
        {% if task.requiresDocument and task.status in ['pending', 'in_review'] %}
            <div class="doc-notice">
                <span class="doc-notice__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>
                </span>
                <div>
                    <div class="doc-notice__title">{{ task.deliverable.label }}</div>
                    <div class="doc-notice__sub">{{ task.deliverable.instruction }}</div>
                </div>
            </div>
        {% endif %}

        {# Lo entregado: el enlace, el archivo, o los dos. Se sigue viendo mientras la tarea vuelve del
           revisor, que es cuando hace falta comparar lo entregado con lo que piden cambiar. #}
        {% if task.hasDeliverable and task.status in ['submitted', 'in_review', 'validated'] %}
            <div class="detail-block">
                <div class="detail-block__label">Lo entregado</div>
                {% if task.deliverableReference %}
                    {% if task.deliverableReference starts with 'http' %}
                        <a class="doc-card" href="{{ task.deliverableReference }}" target="_blank" rel="noopener">
                            <span class="doc-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg></span>
                            <span class="doc-card__body"><span class="doc-card__name">{{ task.deliverableReference }}</span><span class="doc-card__meta">Enlace al documento</span></span>
                            <span class="doc-card__open">Abrir</span>
                        </a>
                    {% else %}
                        <p class="detail-prose">{{ task.deliverableReference }}</p>
                    {% endif %}
                {% endif %}
                {% if task.deliverableFilePath %}
                    <a class="doc-card" href="{{ path('task_deliverable_download', { id: task.id }) }}">
                        <span class="doc-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.05 12.25 20.2a5 5 0 0 1-7.07-7.07l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95l-9.2 9.19a2 2 0 0 1-2.82-2.83l8.49-8.48"/></svg></span>
                        <span class="doc-card__body"><span class="doc-card__name">{{ task.deliverableFileName }}</span><span class="doc-card__meta">Archivo adjunto</span></span>
                        <span class="doc-card__open">Descargar</span>
                    </a>
                {% endif %}
                {% if canEditDeliverable and task.deliverable.acceptsLink %}
                    <form method="post" action="{{ path('task_set_deliverable', { id: task.id }) }}" class="deliverable-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('task_deliverable' ~ task.id) }}">
                        <input type="url" name="reference" value="{{ task.deliverableReference }}" placeholder="https://cloud.educa.madrid.org/…" class="deliverable-input">
                        <button type="submit" class="btn btn-secondary">Actualizar enlace</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

        {# ---- Conversación de la tarea. Aparte del histórico: uno es lo que la aplicación vio cambiar y
               este es lo que las personas se dijeron. Sin tope de vueltas. ---- #}
        {% if comments is not empty or canComment %}
            <div class="detail-block">
                <div class="detail-block__label">Comentarios</div>
                {% if comments is empty %}
                    <p class="muted" style="margin-top:0">Todavía no hay comentarios.</p>
                {% else %}
                    <ol class="thread">
                        {% for c in comments %}
                            <li class="thread__item{{ c.transition == 'review' ? ' thread__item--review' : '' }}">
                                <div class="thread__head">
                                    <span class="thread__who">{{ c.author ? c.author.fullName : 'Alguien que ya no está en el centro' }}</span>
                                    {% if c.lead %}<span class="thread__lead">{{ c.lead }}</span>{% endif %}
                                    <time class="thread__when" datetime="{{ c.createdAt|date('c') }}">{{ c.createdAt|date('d/m/Y H:i') }}</time>
                                </div>
                                <p class="thread__body">{{ c.body|nl2br }}</p>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}

                {% if canComment %}
                    <form method="post" action="{{ path('task_comment', { id: task.id }) }}" class="thread__form">
                        <input type="hidden" name="_token" value="{{ csrf_token('task_comment' ~ task.id) }}">
                        <label class="visually-hidden" for="comentario-suelto">Escribe un comentario</label>
                        <textarea id="comentario-suelto" name="comentario" rows="2" maxlength="2000" placeholder="Escribe un comentario para quien lleva esta tarea…"></textarea>
                        <button type="submit" class="btn btn-secondary">Comentar</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

      </div>{# /detail-main #}

      <aside class="detail-aside">
        {# Delegar (solo titular con equipo o admin) #}
        {% if canDelegate %}
            <div class="detail-block">
                <div class="detail-block__label">Delegar</div>
                <p class="muted" style="margin-top:0">Pásala a alguien de tu equipo; sigue siendo {{ task.responsibility ? task.responsibility.label : 'de su responsable' }}.</p>
                <form method="post" action="{{ path('task_delegate', { id: task.id }) }}" class="delegate-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('task_delegate' ~ task.id) }}">
                    <select name="delegatedTo" id="delegatedTo">
                        <option value="">— Sin delegar —</option>
                        {% for u in delegatable %}
                            <option value="{{ u.id }}"{{ task.delegatedTo and task.delegatedTo.id == u.id ? ' selected' : '' }}>{{ u.fullName }}</option>
                        {% endfor %}
                    </select>
                    <button class="btn btn-secondary" type="submit">Guardar</button>
                </form>
            </div>
        {% endif %}

        {# Recordar: acción de SUPERVISIÓN (quien responde de la tarea sin tener que hacerla), fuera de la
           barra de acciones porque no cambia el estado de nada — y fuera de su `if`, porque sobre una
           Pendiente que no es tuya puede ser lo ÚNICO que puedas hacer. #}
        {% if canRemind %}
            <div class="detail-block">
                <div class="detail-block__label">Recordatorio</div>
                {% if remindedAt %}
                    {# El tope es del servidor: ofrecer el botón otra vez solo daría un "ya se avisó hoy". #}
                    <p class="muted" style="margin-top:0">Avisado hoy a las {{ remindedAt|date('H:i', false) }}. Se puede volver a avisar mañana.</p>
                {% else %}
                    <p class="muted" style="margin-top:0">Avisa a quien tiene que hacerla, en la app, por correo y en el móvil. Un aviso al día como máximo.</p>
                    <form method="post" action="{{ path('task_remind', { id: task.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('task_remind' ~ task.id) }}">
                        <button class="btn btn-secondary" type="submit">Recordar</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}

        {# Actividad real (histórico ya humanizado) — la "línea de estado" del diseño #}
        {% if canSeeHistory %}
            <div class="detail-block">
                <div class="detail-block__label">Actividad</div>
                {{ include('_partials/_activity_log.html.twig', { rows: activityRows, isAdmin: isAdmin }) }}
            </div>
        {% endif %}

        {# Barra de acciones (fija abajo en móvil, en el aside en escritorio). Conserva formularios y guards. #}
        {% if actions is not empty %}
        {# "Validar" juzga algo ENTREGADO; sobre una Pendiente el mismo cierre es "Dar por finalizada"
           (el superior da por hecho lo que le consta, sin que nadie haya entregado). Mismo verbo del
           workflow, dos nombres, porque para quien mira son dos gestos distintos. #}
        {% set labels = { 'submit': task.inReview ? 'Volver a entregar' : 'Entregar tarea', 'validate': task.pending ? 'Dar por finalizada' : 'Validar', 'review': 'Devolver para revisar', 'cancel': 'Cancelar' } %}
        {# Cada acción puede llevar un comentario para la otra parte; devolver lo EXIGE (lo comprueba el
           servidor). Cancelar no lo lleva: no hay a quién contárselo, la tarea deja de existir. #}
        {% set commented = { 'submit': 'Cuéntale algo a quien la revisa (opcional)', 'review': 'Explica qué hay que modificar', 'validate': 'Un comentario de cierre (opcional)' } %}
        <div class="actionbar">
            {% for name in actions %}
                <form method="post" action="{{ path('task_transition', { id: task.id, transition: name }) }}" class="actionbar__form actionbar__form--{{ name }}"{% if name == 'submit' and task.deliverable.acceptsFile %} enctype="multipart/form-data"{% endif %}{% if name == 'cancel' %} data-confirm="¿Cancelar esta tarea? Quedará anulada."{% endif %}>
                    <input type="hidden" name="_token" value="{{ csrf_token('task_transition' ~ task.id) }}">
                    {% if name == 'submit' and task.deliverable.acceptsLink %}
                        <label class="visually-hidden" for="entrega-enlace">Enlace al documento</label>
                        <input type="url" id="entrega-enlace" name="reference" value="{{ task.deliverableReference }}" placeholder="Enlace al documento (https://…)" class="actionbar__input"{{ task.deliverable.value == 'link' and not task.hasDeliverable ? ' required' : '' }}>
                    {% endif %}
                    {% if name == 'submit' and task.deliverable.acceptsFile %}
                        <label class="visually-hidden" for="entrega-archivo">Archivo adjunto</label>
                        <input type="file" id="entrega-archivo" name="archivo" class="actionbar__file"{{ task.deliverable.value == 'file' and not task.hasDeliverable ? ' required' : '' }}>
                    {% endif %}
                    {% if commented[name] is defined %}
                        <label class="visually-hidden" for="comentario-{{ name }}">{{ commented[name] }}</label>
                        <textarea id="comentario-{{ name }}" name="comentario" rows="2" maxlength="2000" class="actionbar__note" placeholder="{{ commented[name] }}"{{ name == 'review' ? ' required' : '' }}></textarea>
                    {% endif %}
                    <button type="submit" class="btn-lg btn-lg--{{ name in ['submit', 'validate'] ? 'primary' : (name == 'review' ? 'danger' : 'muted') }}">
                        {% if name == 'validate' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-11"/></svg>{% endif %}{{ labels[name]|default(name) }}
                    </button>
                </form>
            {% endfor %}
        </div>
        {% endif %}
      </aside>{# /detail-aside #}
    </div>{# /detail-cols #}
{% endblock %}

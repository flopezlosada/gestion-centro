{% extends 'app_shell.html.twig' %}
{% import '_macros/task.html.twig' as taskUi %}
{# Cuando dirección mira el horario de otra persona, todos los enlaces del calendario la conservan. #}
{% set who = viewedTeacher ? { docente: viewedTeacher.id } : {} %}

{% block title %}{{ viewedTeacher ? 'Horario de ' ~ viewedTeacher.fullName : 'Calendario' }} · {{ label }} · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Calendario{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            {% if viewedTeacher %}
                <h1>Horario de {{ viewedTeacher.fullName }}</h1>
                <p class="lead">Sus clases, guardias y reuniones. Su agenda personal, sus tareas y su programación de clases no se muestran.</p>
            {% else %}
                <h1>Calendario de tareas</h1>
                <p class="lead">El plan de tareas del centro, por fecha límite. Cambia el nivel de zoom: día, semana, mes o año.</p>
            {% endif %}
        </div>
        {# Crear desde aquí tiene que verse: el «+» de cada día solo asoma al pasar el ratón por la celda,
           así que en el móvil no aparece nunca. En la vista de día el evento nace ese día. #}
        {% if not viewedTeacher %}
            <a class="btn" href="{{ path('personal_event_new', view == 'dia' ? { fecha: anchor|date('Y-m-d') } : {}) }}">+ Nuevo evento</a>
        {% endif %}
    </div>

    {# Solo dirección y admin reciben la lista: ven el horario de cualquier docente (GET, auto-envío). #}
    {% if teachers is not empty %}
        <div class="card">
            <form method="get" action="{{ path('calendar_index') }}" class="inline-form">
                <input type="hidden" name="vista" value="{{ view in ['dia', 'semana'] ? view : 'semana' }}">
                <input type="hidden" name="fecha" value="{{ anchor|date('Y-m-d') }}">
                <label class="field-label" for="docente">Ver el horario de</label>
                <select id="docente" name="docente" onchange="this.form.submit()">
                    <option value="">— mi calendario —</option>
                    {% for t in teachers %}
                        <option value="{{ t.id }}" {{ viewedTeacher and viewedTeacher.id == t.id ? 'selected' }}>{{ t.fullName }}</option>
                    {% endfor %}
                </select>
                <noscript><button type="submit" class="btn">Ver</button></noscript>
            </form>
        </div>
    {% endif %}

    <div class="card">
        <div class="calendar-toolbar">
            <a class="btn secondary btn-sm" href="{{ path('calendar_index', { vista: view, fecha: prevDate }|merge(who)) }}" rel="prev">‹ Anterior</a>
            <h2 class="calendar-title">{{ label }}</h2>
            <a class="btn secondary btn-sm" href="{{ path('calendar_index', { vista: view, fecha: nextDate }|merge(who)) }}" rel="next">Siguiente ›</a>
        </div>

        <div class="calendar-views">
            {% set viewLabels = { dia: 'Día', semana: 'Semana', mes: 'Mes', anio: 'Año' } %}
            <nav class="calendar-views-tabs" aria-label="Nivel de zoom del calendario">
                {% for v in views %}
                    <a class="calendar-view{{ v == view ? ' is-active' }}"{{ v == view ? ' aria-current="page"' }}
                       href="{{ path('calendar_index', { vista: v, fecha: anchor|date('Y-m-d') }|merge(who)) }}">{{ viewLabels[v] }}</a>
                {% endfor %}
            </nav>
            <a class="btn secondary btn-sm" href="{{ path('calendar_index', { vista: view, fecha: todayDate }|merge(who)) }}">Hoy</a>
        </div>

        {% include template %}

        {% if view != 'dia' and not viewedTeacher %}
            <ul class="calendar-legend" aria-label="Filtrar por estado (pulsa para ocultar/mostrar)">
                {% for status in ['pending', 'submitted', 'validated', 'cancelled'] %}
                    <li><button type="button" class="calendar-legend__toggle" data-filter-status="{{ status }}" aria-pressed="true">{{ taskUi.status_dot(status) }} {{ taskUi.status_label(status) }}</button></li>
                {% endfor %}
                {# Los eventos personales no filtran por estado; el marcador es cuadrado (las tareas, círculo)
                   y su color indica la categoría del evento. #}
                <li class="calendar-legend__static"><span class="calendar-dot calendar-dot--event"></span> Evento personal (el color es su categoría)</li>
                <li class="calendar-legend__static"><span class="calendar-guardia-icon calendar-guardia-icon--legend" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg></span> Guardia</li>
            </ul>
        {% endif %}
    </div>
{% endblock %}

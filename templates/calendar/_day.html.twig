{% import '_macros/task.html.twig' as taskUi %}
{% import '_macros/calendar.html.twig' as cal %}

<div class="calendar-dayview">
    <div class="calendar-dayview-actions">
        {# Alta rápida del propio día (botón visible, no el "+" de hover de la rejilla). #}
        {{ cal.add_menu(day, 'inline') }}
    </div>

    {% if day.nonLective %}
        <p class="calendar-dayview-flag calendar-dayview-flag--nonlective">
            <span class="calendar-legend-swatch calendar-legend-swatch--nonlective"></span>
            Día no lectivo · {{ day.nonLective.description }}
        </p>
    {% elseif day.isWeekend %}
        <p class="calendar-dayview-flag">Fin de semana</p>
    {% endif %}

    {% set guardias = day.guardias ?? [] %}
    {% set meetings = day.meetings ?? [] %}
    {% set classes = classesByDay[day.date|date('Y-m-d', false)] ?? [] %}
    {% if day.tasks is empty and day.events is empty and guardias is empty and meetings is empty and classes is empty %}
        <div class="empty-state">
            <p>No hay clases, guardias, reuniones, tareas ni eventos este día.</p>
        </div>
    {% else %}
        <ol class="agenda-list">
            {# Guardias primero: son el ancla del día. Marcador ESCUDO, forma distinta de la tarea
               (círculo) y del evento (cuadrado). Solo llegan las asignadas al propio usuario, y cada una
               lleva a SU detalle: es donde está la tarea del grupo y el recordatorio de RAICES. #}
            {% for g in guardias %}
                <li class="agenda-item agenda-item--guardia">
                    <span class="agenda-guardia-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg>
                    </span>
                    <div class="agenda-body">
                        <a href="{{ path('guardia_cover_show', { id: g.id }) }}" class="agenda-title">Guardia{% if g.effectiveRoomName %} · {{ g.effectiveRoomName }}{% endif %}</a>
                        <span class="agenda-meta">Cubres a {{ g.absentTeacher.fullName }}{% if g.groupName %} · {{ g.groupName }}{% endif %}</span>
                    </div>
                </li>
            {% endfor %}
            {# Tus clases del día, con el aula REAL (la de un plan de espacios aprobado si movió la clase).
               Marcador LIBRO, otra forma más. Cada una lleva a su programación, y si ya está programada se
               ve aquí mismo qué toca. #}
            {% for c in classes %}
                {% set p = plansByClass[day.date|date('Y-m-d', false) ~ '|' ~ c.slotIndex] ?? null %}
                <li class="agenda-item agenda-item--class">
                    <span class="agenda-class-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/></svg>
                    </span>
                    <div class="agenda-body">
                        <a href="{{ path('lesson_plan', { fecha: day.date|date('Y-m-d', false), tramo: c.slotIndex }) }}" class="agenda-title">{% if c.startsAt %}{{ c.startsAt|date('H:i') }}{% else %}{{ c.ordinal }}ª hora{% endif %} · {{ c.groups|join(', ') }}{% if c.subjects is not empty %} · {{ c.subjects|join(', ') }}{% endif %}</a>
                        <span class="agenda-meta">Clase{% if c.rooms is not empty %} · {{ c.rooms|join(', ') }}{% endif %}{% if c.isRelocated %} · aula cambiada{% endif %}
                            {%- if p %} · {{ [p.topic ? p.topic.name : null, p.activity ? p.activity.label : null, p.outcome ? p.outcome.label : null]|filter(v => v)|join(' · ') ?: 'programada' }}{% else %} · sin programar{% endif %}</span>
                    </div>
                </li>
            {% endfor %}
            {# Reuniones convocadas: marcador PERSONAS, otra forma más (escudo=guardia, círculo=tarea,
               cuadrado=evento). Solo llegan las que conciernen al usuario. Con hora, que es lo que hay
               que saber para no llegar tarde. #}
            {% for m in meetings %}
                <li class="agenda-item agenda-item--meeting">
                    <span class="agenda-meeting-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/><circle cx="9" cy="7" r="3"/><path d="M22 19v-1a4 4 0 0 0-3-3.87"/><path d="M16 3.13A4 4 0 0 1 19 7a4 4 0 0 1-.75 2.33"/></svg>
                    </span>
                    <div class="agenda-body">
                        <a href="{{ path('meeting_show', { id: m.id }) }}" class="agenda-title">{{ m.startAt|date('H:i') }} · {{ m.title }}</a>
                        <span class="agenda-meta">Reunión{% if m.place %} · {{ m.place }}{% endif %}{% if m.project %} · {{ m.project.name }}{% endif %}</span>
                    </div>
                </li>
            {% endfor %}
            {# canWork calculado en el cuerpo (aquí `is_granted`/`app` sí están disponibles) y pasado
               al macro: mismo criterio que TaskController::canWorkOn (admin o dueño de la tarea). #}
            {# `day.date` viaja en el POST del tick para volver a ESTE día y no a Inicio (TickOutcome). #}
            {% for task in day.tasks %}
                {{ taskUi.agenda_item(task, is_granted('ROLE_ADMIN') or task.isOwnedBy(app.user), day.date) }}
            {% endfor %}
            {# Los eventos personales son privados del usuario; solo llegan aquí los suyos. #}
            {% for event in day.events %}
                {{ taskUi.event_item(event, day.date) }}
            {% endfor %}
        </ol>
    {% endif %}
</div>

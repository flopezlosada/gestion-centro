{% import '_macros/task.html.twig' as taskUi %}
{% import '_macros/calendar.html.twig' as cal %}

<div class="calendar-dayview">
    <div class="calendar-dayview-actions">
        {# Alta rápida del propio día (botón visible, no el "+" de hover de la rejilla). #}
        {{ cal.add_menu(day, 'inline') }}
    </div>

    {% if day.nonLective %}
        <p class="calendar-dayview-flag calendar-dayview-flag--nonlective">
            <span class="calendar-legend-swatch calendar-legend-swatch--nonlective"></span>
            Día no lectivo · {{ day.nonLective.description }}
        </p>
    {% elseif day.isWeekend %}
        <p class="calendar-dayview-flag">Fin de semana</p>
    {% endif %}

    {# Lo que no va en la rejilla: tareas (solo llevan fecha de entrega, nunca hora), eventos personales
       —CON hora o sin ella: es donde vive su toque de "hecho", que un bloque no tiene sitio para dar—, y
       —caso raro— una clase cuyo curso no tiene marco horario importado todavía. #}
    {% set hasAllDay = day.tasks is not empty or day.events is not empty or day.unscheduledClasses is not empty %}
    {% if hasAllDay %}
        <ol class="agenda-list agenda-list--allday">
            {% for c in day.unscheduledClasses %}
                <li class="agenda-item agenda-item--class">
                    <span class="agenda-class-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/></svg>
                    </span>
                    <div class="agenda-body">
                        <a href="{{ path('lesson_plan', { fecha: day.date|date('Y-m-d', false), tramo: c.slotIndex }) }}" class="agenda-title">{{ c.ordinal }}ª hora · {{ c.groups|join(', ') }}{% if c.subjects is not empty %} · {{ c.subjects|join(', ') }}{% endif %}</a>
                        <span class="agenda-meta">Clase · sin horario del curso</span>
                    </div>
                </li>
            {% endfor %}
            {# canWork calculado en el cuerpo (aquí `is_granted`/`app` sí están disponibles) y pasado
               al macro: mismo criterio que TaskController::canWorkOn (admin o dueño de la tarea). #}
            {# `day.date` viaja en el POST del tick para volver a ESTE día y no a Inicio (TickOutcome). #}
            {% for task in day.tasks %}
                {{ taskUi.agenda_item(task, is_granted('ROLE_ADMIN') or task.isOwnedBy(app.user), day.date) }}
            {% endfor %}
            {# Los eventos personales son privados del usuario; solo llegan aquí los suyos. #}
            {% for event in day.events %}
                {{ taskUi.event_item(event, day.date) }}
            {% endfor %}
        </ol>
    {% endif %}

    {# Un día lectivo pinta su rejilla aunque no tenga nada con hora: vacía, dice «día libre» igual que la
       columna vacía de la semana; sin ella, un día con solo tareas parecía la vista de antes. Fin de
       semana y días no lectivos ya tienen su rótulo arriba, así que ahí la rejilla vacía solo sobraría. #}
    {% set showGrid = day.timeline is not empty or not (day.isWeekend or day.nonLective) %}
    {% if not showGrid %}
        {% if not hasAllDay %}
            <div class="empty-state">
                <p>No hay nada este día.</p>
            </div>
        {% endif %}
    {% else %}
        {# La altura se fija aquí, en px, porque el top/height en % de cada hora y cada bloque solo tiene
           sentido si el contenedor mide algo concreto — si no, un % de "lo que ocupe el contenido" es
           circular. --cal-hours la usa el CSS para el alto real (ver .cal-timeline__axis/__grid). #}
        <div class="cal-timeline" style="--cal-hours: {{ day.hourMarks|length }}">
            <div class="cal-timeline__axis" aria-hidden="true">
                {% for h in day.hourMarks %}
                    <span class="cal-timeline__hour" style="top: {{ h.top }}%">{{ h.label }}</span>
                {% endfor %}
            </div>
            <div class="cal-timeline__grid">
                {% for h in day.hourMarks %}
                    <span class="cal-timeline__gridline" style="top: {{ h.top }}%"></span>
                {% endfor %}
                {% if day.nowTop is not null %}
                    <span class="cal-timeline__now" style="top: {{ day.nowTop }}%"></span>
                {% endif %}
                {% for pos in day.timeline %}
                    {{ cal.timeline_block(pos) }}
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>

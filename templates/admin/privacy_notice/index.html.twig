{% extends 'app_shell.html.twig' %}

{% block title %}Protección de datos{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Protección de datos
{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">Administración</p>
            <h1>Protección de datos</h1>
            {% if families %}
                <p class="lead">La información que cada familia colaboradora tiene que aceptar al entrar en su espacio. Aquí sí es un consentimiento: colaborar es voluntario, así que la familia puede decir que no, y entonces se borran su cuenta y sus datos.</p>
            {% else %}
                <p class="lead">La información que cada persona tiene que leer al entrar. Es información, no un consentimiento: el centro trata estos datos por obligación legal, y lo que se guarda es la prueba de que cada cual la ha leído.</p>
            {% endif %}
        </div>
    </div>

    <nav class="tabs" aria-label="Para quién es el texto">
        <a class="tab{{ not families ? ' is-active' }}" href="{{ path('admin_privacy_notice_index') }}"{{ not families ? ' aria-current="page"' }}>Personal</a>
        <a class="tab{{ families ? ' is-active' }}" href="{{ path('admin_privacy_notice_index', { para: 'familias' }) }}"{{ families ? ' aria-current="page"' }}>Familias</a>
    </nav>

    <div class="card">
        {% if current %}
            <h2>Versión en vigor {{ families ? 'para las familias' : 'para el personal' }}</h2>
            {% if families %}
                <p>Publicada el {{ current.publishedAt|date('d/m/Y \\a \\l\\a\\s H:i') }}{% if current.publishedBy %} por {{ current.publishedBy.fullName }}{% endif %}. La han aceptado <strong>{{ readers }} de {{ audienceSize }}</strong> familias con cuenta.</p>
                <p><a href="{{ path('family_privacy_public') }}">Ver cómo se muestra</a></p>
            {% else %}
                <p>Publicada el {{ current.publishedAt|date('d/m/Y \\a \\l\\a\\s H:i') }}{% if current.publishedBy %} por {{ current.publishedBy.fullName }}{% endif %}. La han leído <strong>{{ readers }} de {{ audienceSize }}</strong> personas con la cuenta activa.</p>
                <p><a href="{{ path('privacy_notice_public') }}">Ver cómo se muestra</a></p>
            {% endif %}
        {% elseif families %}
            <div class="callout" role="note">
                Todavía no hay ninguna versión publicada, así que <strong>ninguna familia puede usar su espacio</strong>: al entrar se les pide aceptar este texto, y sin texto no hay nada que aceptar. Publícalo antes de abrir el espacio de familias.
            </div>
        {% else %}
            <div class="callout" role="note">
                Todavía no hay ninguna versión publicada, así que <strong>no se le pide a nadie</strong>. En cuanto publiques la primera, cada persona la verá al abrir la aplicación y no podrá seguir hasta pulsar «Entendido».
            </div>
        {% endif %}
    </div>

    <form class="card stack-form" method="post" action="{{ path('admin_privacy_notice_publish') }}"
          data-confirm="{{ families
              ? 'Al publicar, cada familia tendrá que volver a aceptarla antes de seguir usando su espacio. ¿Publicar?'
              : 'Al publicar, todo el personal tendrá que volver a leerla y pulsar «Entendido» antes de seguir. ¿Publicar?' }}">
        <input type="hidden" name="_token" value="{{ csrf_token('privacy_notice_publish') }}">
        {% if families %}<input type="hidden" name="para" value="familias">{% endif %}
        <h2>{{ current ? 'Publicar una versión nueva' : 'Publicar la primera versión' }} {{ families ? 'para las familias' : 'para el personal' }}</h2>
        <p class="help">Una versión publicada no se edita; cualquier cambio, aunque sea una errata, es una versión nueva.</p>

        <div class="field">
            <label for="summary">Resumen</label>
            <p class="field-help">Lo primero que se lee. Escrito como <strong>una línea por punto, «Etiqueta: texto»</strong> (Responsable: …, Finalidad: …, Legitimación: …, Destinatarios: …, Derechos: …, Delegado de protección de datos: …), se muestra como una ficha; si no, como texto seguido.</p>
            <textarea id="summary" name="summary" rows="8" required maxlength="30000">{{ current ? current.summary }}</textarea>
        </div>

        <div class="field">
            <label for="body">Información completa</label>
            <p class="field-help">Aparece plegada bajo el resumen. Texto plano: se respetan los saltos de línea.</p>
            <textarea id="body" name="body" rows="16" required maxlength="30000">{{ current ? current.body }}</textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Publicar</button>
        </div>
    </form>
{% endblock %}

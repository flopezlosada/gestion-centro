{% extends 'app_shell.html.twig' %}

{% block title %}{{ department ? 'Temas · ' ~ department : 'Temas de las clases' }}{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    {% if department and canPickDepartment %}
        <a href="{{ path('admin_topic_index') }}">Temas de las clases</a><span class="sep">/</span>{{ department }}
    {% else %}
        Temas de las clases
    {% endif %}
{% endblock %}

{% block page_scripts %}
    <script src="{{ asset_ver('/js/topic-index.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="topics-page">
        {% if department is null %}
            {# Quien alcanza varios departamentos (dirección, jefatura de estudios, admin) elige uno: el
               centro entero de golpe eran ochenta y tantas materias, y nadie busca fuera de su departamento. #}
            <header class="page-head">
                <div>
                    <h1>Temas de las clases</h1>
                    <p class="lead">El temario de cada materia y curso, el que el profesorado elige al programar una clase. Cada jefe o jefa de departamento lleva el de sus materias; elige un departamento para verlo.</p>
                </div>
            </header>

            {% if cards is empty %}
                <div class="empty-state">
                    <h2>Todavía no hay horario importado</h2>
                    <p>Los departamentos y sus materias aparecen aquí en cuanto el curso tiene horario.</p>
                </div>
            {% else %}
                <ul class="topic-departments">
                    {% for c in cards %}
                        <li>
                            <a class="topic-department{{ c.subjects == 0 ? ' is-empty' }}{{ c.withTopics > 0 ? ' has-topics' }}" href="{{ path('admin_topic_index', { departamento: c.id }) }}">
                                <span class="topic-department__name">{% if c.subjects > 0 %}<span class="lesson-mark{{ c.withTopics > 0 ? ' is-on' }}" aria-hidden="true"></span>{% endif %}{{ c.name }}</span>
                                <span class="topic-department__meta">
                                    {%- if c.subjects == 0 -%}
                                        sin materias en el horario
                                    {%- else -%}
                                        {{ c.subjects }} materia{{ c.subjects == 1 ? '' : 's' }} · {% if c.withTopics > 0 %}<strong>{{ c.withTopics }} con temas</strong>{% else %}sin temas{% endif %}
                                    {%- endif -%}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% else %}
            <header class="topic-head">
                <p class="topic-head__level">Temas de las clases</p>
                <h1 class="topic-head__subject">{{ department }}</h1>
                <p class="topic-head__meta">
                    {{- subjects|length }} materia{{ subjects|length == 1 ? '' : 's' }} · {{ subjects|filter(s => s.hasTopics)|length }} con temas
                </p>
            </header>

            {% if subjects is empty %}
                <p class="muted">Este departamento no da ninguna materia en el horario de este curso.</p>
            {% else %}
                {# Una fila por materia, con sus cursos al lado; cada curso con su número de temas, y sin
                   temas en hueco, para ver de un vistazo qué falta por preparar. #}
                {% if subjects|length > 8 %}
                    <div class="topic-finder">
                        <label class="visually-hidden" for="buscar-materia">Busca una materia</label>
                        <input type="search" id="buscar-materia" placeholder="Busca una materia" autocomplete="off" data-topic-filter>
                    </div>
                {% endif %}
                <ul class="topic-subjects" data-topic-subjects>
                    {% for s in subjects %}
                        <li class="topic-subject{{ s.hasTopics ? ' has-topics' }}" data-name="{{ s.subject }}">
                            <span class="topic-subject__name"><span class="lesson-mark{{ s.hasTopics ? ' is-on' }}" aria-hidden="true"></span>{{ s.subject }}</span>
                            <span class="topic-subject__levels">
                                {% for l in s.levels %}
                                    <a class="topic-level{{ l.count > 0 ? ' has-topics' }}"
                                       href="{{ path('admin_topic_show', { subject: s.subject, level: l.level ? l.level.value : '' }) }}"
                                       title="{{ s.subject }} · {{ l.level ? l.level.label : 'sin nivel reconocido' }}: {{ l.count > 0 ? l.count ~ ' tema' ~ (l.count == 1 ? '' : 's') : 'sin temas' }}">
                                        <span class="topic-level__name">{{ l.level ? l.level.shortLabel : 'Sin nivel' }}</span>
                                        <span class="topic-level__count">{{ l.count > 0 ? l.count : '—' }}</span>
                                    </a>
                                {% endfor %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
                <p class="topic-finder__none" hidden data-topic-none>Ninguna materia se llama así.</p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

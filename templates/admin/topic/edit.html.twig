{% extends 'app_shell.html.twig' %}

{% block title %}Temas de {{ subject }}{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('admin_topic_index') }}">Temas de las clases</a><span class="sep">/</span>
    {{ subject }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">Administración</p>
            <h1>{{ subject }}{% if level %} · {{ level.label }}{% else %} · sin nivel reconocido{% endif %}</h1>
            <p class="lead">El orden es el orden en que se dan los temas: es lo que usa el avance («tema 4 de 9»). Un tema retirado deja de ofrecerse, pero las clases ya programadas con él lo conservan tal cual.</p>
        </div>
    </div>

    {% set csrf = csrf_token('admin_topic' ~ subject ~ (level ? level.value : '')) %}

    {% if pasted is not empty %}
        <div class="card">
            <p class="eyebrow">Del pegado · {{ pasted|length }} tema{{ pasted|length == 1 ? '' : 's' }} nuevo{{ pasted|length == 1 ? '' : 's' }}</p>
            <p class="help">Todavía no se ha guardado nada. Revísalos, corrígelos o quítalos abajo y pulsa «Guardar la lista».</p>
        </div>
    {% endif %}

    <div class="card">
        <form method="post" class="stack-form" data-confirm="{% if topics is not empty or pasted is not empty %}¿Guardar la lista? Los temas que quites de aquí (o dejes en blanco) desaparecen.{% endif %}">
            <input type="hidden" name="_token" value="{{ csrf }}">

            <table class="topic-editor">
                <thead>
                    <tr><th>Orden</th><th>Nombre</th><th>Retirado</th></tr>
                </thead>
                <tbody>
                    {% for t in topics %}
                        <tr>
                            <td><input type="hidden" name="tema_id[]" value="{{ t.id }}"><input type="number" name="tema_orden[]" class="mono" value="{{ loop.index }}" min="1" required></td>
                            <td><input type="text" name="tema_nombre[]" value="{{ t.name }}" maxlength="{{ constant('App\\Entity\\Topic::MAX_NAME') }}" required></td>
                            <td><input type="checkbox" name="tema_retirado[]" value="{{ loop.index0 }}"{{ t.retired ? ' checked' }}></td>
                        </tr>
                    {% endfor %}
                    {% for name in pasted %}
                        <tr class="is-new">
                            <td><input type="hidden" name="tema_id[]" value="new-{{ loop.index0 }}"><input type="number" name="tema_orden[]" class="mono" value="{{ topics|length + loop.index }}" min="1" required></td>
                            <td><input type="text" name="tema_nombre[]" value="{{ name }}" maxlength="{{ constant('App\\Entity\\Topic::MAX_NAME') }}" required></td>
                            <td><input type="checkbox" name="tema_retirado[]" value="{{ topics|length + loop.index0 }}"></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if topics is empty and pasted is empty %}
                <p class="muted">Todavía no hay ningún tema. Pega la programación de abajo o espera a que el primero se cree solo al programar una clase.</p>
            {% else %}
                <p class="help">El número de la izquierda es el orden: cambia el número de un tema para moverlo (dos temas con el mismo número se ordenan como estaban).</p>
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="btn">Guardar la lista</button>
                <a class="btn secondary" href="{{ path('admin_topic_index') }}">Volver</a>
            </div>
        </form>
    </div>

    {% if topics|length > 1 %}
        <div class="card">
            <p class="eyebrow">Fusionar un duplicado</p>
            <p class="help">Junta dos temas que son el mismo (uno creado al vuelo con otro nombre que el de la programación). Las clases ya programadas con el primero pasan a contar como el segundo, y el primero desaparece. No se puede deshacer.</p>
            <form method="post" action="{{ path('admin_topic_merge', { subject: subject, level: level ? level.value : '' }) }}" class="inline-form" data-confirm="¿Fusionar? No se puede deshacer.">
                <input type="hidden" name="_token" value="{{ csrf }}">
                <select name="desde" required>
                    <option value="">— Este tema…</option>
                    {% for t in topics %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}
                </select>
                <span>se fusiona en</span>
                <select name="hacia" required>
                    <option value="">— …este otro —</option>
                    {% for t in topics %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}
                </select>
                <button type="submit" class="btn secondary">Fusionar</button>
            </form>
        </div>
    {% endif %}

    <div class="card">
        <p class="eyebrow">Pegar la programación</p>
        <p class="help">Pega la lista de temas de la programación didáctica, uno por línea (vale con la numeración delante: «Tema 1. Ecuaciones», «UD 2 - Potencias»…). No se guarda nada todavía: primero se muestra la lista de arriba para revisarla.</p>
        <form method="post" action="{{ path('admin_topic_paste_preview', { subject: subject, level: level ? level.value : '' }) }}">
            <input type="hidden" name="_token" value="{{ csrf }}">
            <textarea name="pegado" rows="6" placeholder="Tema 1. Números racionales&#10;Tema 2. Potencias y raíces&#10;Tema 3. Polinomios"></textarea>
            <div class="form-actions">
                <button type="submit" class="btn secondary">Ver los temas</button>
            </div>
        </form>
    </div>
{% endblock %}

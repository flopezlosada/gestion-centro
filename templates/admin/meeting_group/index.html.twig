{% extends 'app_shell.html.twig' %}
{% import 'admin/meeting_group/_macros.html.twig' as g %}

{% block title %}Grupos de convocatoria{% endblock %}

{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Grupos de convocatoria{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">Administración</p>
            <h1>Grupos de convocatoria</h1>
            <p class="lead">Listas guardadas de gente que se convoca junta a menudo: «Tutores/as 2º ESO», «CCP»… Al convocar una reunión, elegir el grupo marca a sus miembros de una vez, sin pinchar uno a uno. Cambiarlos aquí no toca las reuniones ya convocadas. Los que se reúnen cada semana (los del horario de Peñalara) crean solos su reunión en cuanto tienen a alguien que convoque.</p>
        </div>
        <a class="btn" href="{{ path('admin_meeting_group_new') }}">+ Nuevo grupo</a>
    </div>

    <div class="card">
        {% if groups is empty %}
            <div class="empty-state">
                <h2>No hay grupos de convocatoria todavía</h2>
                <p>Crea el primero y marca a quién incluye.</p>
                <a class="btn" href="{{ path('admin_meeting_group_new') }}">Nuevo grupo</a>
            </div>
        {% else %}
            <table data-list-tools>
                <thead>
                    <tr><th>Nombre</th><th data-filter>Tipo</th><th>Miembros</th><th>Cada semana</th><th>Convoca</th><th data-filter>Estado</th><th data-nosort></th></tr>
                </thead>
                <tbody>
                    {% for group in groups %}
                        <tr>
                            <td><a href="{{ path('admin_meeting_group_show', { id: group.id }) }}">{{ group.name }}</a></td>
                            <td>{{ group.type ? group.type.name : 'Sin tipo' }}</td>
                            <td>{{ group.members|length }}</td>
                            <td>{{ g.schedule(group, slotLabels) }}</td>
                            <td>{{ group.convener ? group.convener.fullName : '—' }}</td>
                            <td>{{ g.status(group) }}</td>
                            <td class="row-actions">
                                <details class="row-menu">
                                    <summary aria-label="Acciones de «{{ group.name }}»" title="Acciones">⋮</summary>
                                    <div class="row-menu__panel">
                                        <a href="{{ path('admin_meeting_group_edit', { id: group.id }) }}">Editar</a>
                                        <form method="post" action="{{ path('admin_meeting_group_delete', { id: group.id }) }}" data-confirm="¿Borrar el grupo «{{ group.name }}»? No afecta a ninguna reunión ya convocada: solo deja de ofrecerse como atajo.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('meeting_group_delete' ~ group.id) }}">
                                            <button type="submit" class="link-danger">Borrar</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}

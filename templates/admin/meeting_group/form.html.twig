{% extends 'app_shell.html.twig' %}
{% import '_macros/form.html.twig' as f %}

{% block title %}{{ group.id ? 'Editar grupo de convocatoria' : 'Nuevo grupo de convocatoria' }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>
    <a href="{{ path('admin_meeting_group_index') }}">Grupos de convocatoria</a><span class="sep">/</span>
    {{ group.id ? 'Editar' : 'Nuevo' }}
{% endblock %}

{% block body %}
    <div class="page-head">
        <p class="eyebrow">Grupos de convocatoria</p>
        <h1>{{ group.id ? 'Editar grupo de convocatoria' : 'Nuevo grupo de convocatoria' }}</h1>
    </div>

    <div class="card form-card">
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
            {{ f.submit_error(form) }}
            {{ form_errors(form) }}
            {{ f.fields([form.name]) }}
            <fieldset class="form-section">
                <legend class="form-section-title">Quién lo forma</legend>
                {% if form.members.vars.help %}<p class="help">{{ form.members.vars.help }}</p>{% endif %}
                {{ f.pick_list(form.members, 'No hay personas de alta todavía.', true) }}
                {{ form_errors(form.members) }}
            </fieldset>
            <fieldset class="form-section">
                <legend class="form-section-title">Reunión semanal</legend>
                <p class="help">Si este grupo se reúne cada semana a la misma hora, la aplicación crea sola cada reunión con una semana de antelación, sin convocarla a mano. Los cambios valen para las semanas que aún no se han creado.{% if group.penalaraKey %} Viene del horario de Peñalara («{{ group.penalaraKey }}»): si cambias aquí el día, la hora o las personas, el próximo import preguntará antes de pisarlo.{% endif %}</p>
                {{ f.fields([form.weekday, form.slotIndex, form.convener, form.type, form.place, form.reminder]) }}
            </fieldset>
            {{ f.toggle(form.active) }}
            {{ f.actions(path('admin_meeting_group_index')) }}
        {{ form_end(form) }}
    </div>
{% endblock %}

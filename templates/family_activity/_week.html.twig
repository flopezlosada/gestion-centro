{#
   Una semana de sesiones como calendario, de lunes a viernes, con el mismo componente que la semana de
   guardias: lo comparten el espacio de familias y la pantalla del profesorado. `mode` decide lo de cada
   uno —«family»: plazas y botones de apuntarse (a esa sesión o, si es semanal, a todas desde ella), en naranja las sesiones a las que va; «staff»: cuántas
   personas vienen, en naranja las que ya tienen a alguien, y cada sesión enlaza al detalle, donde están
   los nombres—. `route` es la ruta de la pantalla, para las flechas; `currentMonday`, la semana de «Esta semana».
#}
{% set dayNames = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie'] %}
{% set longDayNames = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'] %}
{% set monthNames = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'] %}
{% set thisMonday = currentMonday|date('Y-m-d', false) %}
{% set shownMonday = monday|date('Y-m-d', false) %}
{% set friday = monday|date_modify('+4 days') %}
{% set today = now|date('Y-m-d', false) %}

<section class="family-week" aria-labelledby="family-week-title">
    <div class="section-head week-head">
        <h2 id="family-week-title">{{ shownMonday == thisMonday ? 'Esta semana' : 'Semana' }}</h2>
        <span class="week-head__range mono">{{ monday|date('j', false) }}{{ monday|date('n', false) != friday|date('n', false) ? ' ' ~ monthNames[monday|date('n', false) - 1] }}–{{ friday|date('j', false) }} {{ monthNames[friday|date('n', false) - 1] }}</span>
        <nav class="scope-toggle week-head__nav" aria-label="Semana">
            <a href="{{ path(route, { semana: monday|date_modify('-7 days')|date('Y-m-d', false) }) }}">← Anterior</a>
            <a href="{{ path(route, { semana: thisMonday }) }}" class="{{ shownMonday == thisMonday ? 'is-active' }}">Esta semana</a>
            <a href="{{ path(route, { semana: monday|date_modify('+7 days')|date('Y-m-d', false) }) }}">Siguiente →</a>
        </nav>
    </div>

    <ol class="card week-days">
        {% for date, sessions in week %}
            {% set isToday = date == today %}
            <li class="week-day{{ isToday ? ' is-today' }}" aria-label="{{ longDayNames[loop.index0] }} {{ date|date('d/m', false) }}">
                <div class="week-day__head">
                    <span class="week-day__name mono">{{ dayNames[loop.index0] }}</span>
                    <span class="week-day__num">{{ date|date('j', false) }}</span>
                    {% if isToday %}<span class="visually-hidden">(hoy)</span>{% endif %}
                </div>

                <ul class="week-day__slots">
                    {% for s in sessions %}
                        {% set a = s.activity %}
                        {% set past = not s.isOpenAt(now) %}
                        {% set time %}{{ s.startsAt|date('H:i', false) }}{% if s.endsAt %}–{{ s.endsAt|date('H:i', false) }}{% endif %}{% endset %}
                        <li>
                            {% if mode == 'family' %}
                                {# Sin quién organiza ni quién más viene: de las demás personas solo se cuentan las plazas. #}
                                {% set mine = s.isSignedUpBy(app.user) %}
                                {% set left = s.placesLeft %}
                                <div class="week-chip family-chip{{ mine ? ' week-chip--accent' }}{{ past ? ' is-past' }}">
                                    <span class="week-chip__time mono">{{ time }}</span>
                                    <span class="week-chip__where">{{ a.title }}</span>
                                    {% if s.place %}<span class="week-chip__who">{{ s.place }}</span>{% endif %}
                                    {% if a.description %}<span class="family-chip__desc">{{ a.description|nl2br }}</span>{% endif %}
                                    {% if mine %}
                                        <span class="week-chip__tag">Te esperamos</span>
                                        {% if not past %}
                                            <form method="post" action="{{ path('family_withdraw', { id: a.id, fecha: date }) }}" class="family-chip__action">
                                                <input type="hidden" name="_token" value="{{ csrf_token('family_withdraw' ~ a.id ~ '-' ~ date) }}">
                                                <button type="submit" class="btn secondary btn-sm">Ya no puedo ir</button>
                                            </form>
                                            {% if a.weekly %}
                                                <form method="post" action="{{ path('family_withdraw_every', { id: a.id, fecha: date }) }}" class="family-chip__action">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('family_withdraw_every' ~ a.id ~ '-' ~ date) }}">
                                                    <button type="submit" class="btn secondary btn-sm">Ninguna semana más</button>
                                                </form>
                                            {% endif %}
                                        {% endif %}
                                    {% else %}
                                        <span class="week-chip__state">{% if past %}Ya ha empezado{% elseif left is null %}Sin límite de plazas{% elseif left == 0 %}Completa{% else %}{{ left == 1 ? 'Queda 1 plaza' : 'Quedan ' ~ left ~ ' plazas' }}{% endif %}</span>
                                        {% if s.acceptsSignupsAt(now) %}
                                            <form method="post" action="{{ path('family_signup', { id: a.id, fecha: date }) }}" class="family-chip__action">
                                                <input type="hidden" name="_token" value="{{ csrf_token('family_signup' ~ a.id ~ '-' ~ date) }}">
                                                <button type="submit" class="btn btn-sm">Puedo ir</button>
                                            </form>
                                        {% endif %}
                                        {# Desde esta sesión hasta fin de curso; las semanas completas se saltan y se le dice cuáles. #}
                                        {% if a.weekly and not past %}
                                            <form method="post" action="{{ path('family_signup_every', { id: a.id, fecha: date }) }}" class="family-chip__action">
                                                <input type="hidden" name="_token" value="{{ csrf_token('family_signup_every' ~ a.id ~ '-' ~ date) }}">
                                                <button type="submit" class="btn secondary btn-sm">Todas las semanas</button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            {% else %}
                                {# Los nombres no salen aquí: están en el detalle, que solo abre quien organiza. #}
                                {% set coming = s.signups|length %}
                                <a class="week-chip family-chip{{ coming > 0 ? ' week-chip--accent' }}{{ past ? ' is-past' }}" href="{{ path('family_activity_show', { id: a.id }) }}">
                                    <span class="week-chip__time mono">{{ time }}</span>
                                    <span class="week-chip__where">{{ a.title }}</span>
                                    {% if s.place %}<span class="week-chip__who">{{ s.place }}</span>{% endif %}
                                    <span class="{{ coming > 0 ? 'week-chip__tag' : 'week-chip__state' }}">{% if a.familiesWanted %}{{ coming }} de {{ a.familiesWanted }} personas{% else %}{{ coming }} {{ coming == 1 ? 'persona' : 'personas' }}{% endif %}</span>
                                </a>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="week-day__none">Nada</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ol>
</section>

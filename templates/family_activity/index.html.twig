{% extends 'app_shell.html.twig' %}

{% block title %}Actividades con familias · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Actividades con familias{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">El centro</p>
            <h1>Actividades con familias</h1>
            <p class="lead">Grupos interactivos, talleres y demás actividades en las que pueden participar familias. Cualquier docente puede publicar una; solo quien la organiza puede cambiarla.</p>
        </div>
        <div class="page-head-actions">
            {% if is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ADMINISTRATION')) %}
                <a class="btn secondary" href="{{ path('family_volunteer_index') }}">Cuentas de familias</a>
            {% endif %}
            <a class="btn" href="{{ path('family_activity_new') }}">+ Nueva actividad</a>
        </div>
    </div>

    <nav class="scope-toggle" aria-label="Qué actividades ver">
        <a href="{{ path('family_activity_index') }}" class="{{ showingPast ? '' : 'is-active' }}"{{ showingPast ? '' : ' aria-current="page"' }}>Próximas</a>
        <a href="{{ path('family_activity_index', { ver: 'pasadas' }) }}" class="{{ showingPast ? 'is-active' : '' }}"{{ showingPast ? ' aria-current="page"' : '' }}>Pasadas</a>
    </nav>

    <div class="card">
        {% if activities is empty %}
            <div class="empty-state">
                {% if showingPast %}
                    <h2>Todavía no se ha celebrado ninguna</h2>
                {% else %}
                    <h2>No hay actividades programadas</h2>
                    <p>Publica la primera para que el resto del claustro sepa qué se prepara.</p>
                    <a class="btn" href="{{ path('family_activity_new') }}">Nueva actividad</a>
                {% endif %}
            </div>
        {% else %}
            <table>
                <thead>
                    <tr><th>Cuándo</th><th>Actividad</th><th>Lugar</th><th>Familias</th><th>Organiza</th><th></th></tr>
                </thead>
                <tbody>
                    {% for a in activities %}
                        {% set manages = a.isOrganizedBy(app.user) or is_granted('ROLE_ADMIN') %}
                        <tr>
                            <td>
                                <time datetime="{{ a.startAt|date('c', false) }}">{{ a.startAt|date('d/m/Y', false) }}</time><br>
                                {{ a.startAt|date('H:i', false) }}{% if a.endAt %}–{{ a.endAt|date('H:i', false) }}{% endif %}
                            </td>
                            <td>
                                <strong>{{ a.title }}</strong>
                                {% if a.description %}<br><span class="muted">{{ a.description|nl2br }}</span>{% endif %}
                            </td>
                            <td>{{ a.place ?? '—' }}</td>
                            <td>
                                {% set coming = a.signups|length %}
                                {{ coming }}{% if a.familiesWanted %} de {{ a.familiesWanted }}{% else %} (las que puedan){% endif %}
                                {# Los nombres, solo a quien los necesita para organizarse: el resto del claustro ve la cuenta. #}
                                {% if coming > 0 and manages %}
                                    <br><span class="muted">{{ a.signups|map(s => s.family.fullName)|join(', ') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ a.organizer ? a.organizer.fullName : 'Nadie (ya no está en el centro)' }}</td>
                            <td class="row-actions">
                                {% if manages %}
                                    <a href="{{ path('family_activity_edit', { id: a.id }) }}">Editar</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if not showingPast %}
        {# Sin nombres: para elegir el día basta saber cuántas familias pueden y a qué horas. #}
        <section class="card" aria-labelledby="family-availability-title">
            <h2 id="family-availability-title">Cuándo pueden venir las familias</h2>
            {% if availability is empty %}
                <p class="muted">Ninguna familia ha dicho todavía qué días puede venir.</p>
            {% else %}
                <table>
                    <thead>
                        <tr><th>Día</th><th>Familias</th><th>Horas</th></tr>
                    </thead>
                    <tbody>
                        {% for day in weekdays %}
                            {% set spans = availability[day.value] ?? [] %}
                            <tr>
                                <th scope="row">{{ day.label }}</th>
                                <td>{{ spans|length }}</td>
                                <td>{{ spans is empty ? '—' : spans|map(s => s.from|date('H:i', false) ~ '–' ~ s.until|date('H:i', false))|join(', ') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}

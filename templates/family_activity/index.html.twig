{% extends 'app_shell.html.twig' %}

{% block title %}Actividades con familias · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Actividades con familias{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <p class="eyebrow">El centro</p>
            <h1>Actividades con familias</h1>
            <p class="lead">Grupos interactivos, talleres y demás actividades en las que pueden participar familias: en una de tus clases cada semana, o un día suelto. Cualquier docente puede publicar una; solo quien la organiza puede cambiarla.</p>
        </div>
        <div class="page-head-actions">
            {% if is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ADMINISTRATION')) %}
                <a class="btn secondary" href="{{ path('family_volunteer_index') }}">Cuentas de familias</a>
            {% endif %}
            <a class="btn secondary" href="{{ path('family_activity_new') }}">+ Actividad puntual</a>
            <a class="btn" href="{{ path('family_activity_new_weekly') }}">+ En una de mis clases</a>
        </div>
    </div>

    {{ include('family_activity/_week.html.twig', { mode: 'staff', route: 'family_activity_index' }) }}

    <section class="card" aria-labelledby="family-activities-title">
        <h2 id="family-activities-title">Actividades</h2>
        {% if weekly is empty and oneOffs is empty %}
            <div class="empty-state">
                <h2>No hay actividades programadas</h2>
                <p>Publica la primera para que el resto del claustro sepa qué se prepara.</p>
                <a class="btn" href="{{ path('family_activity_new_weekly') }}">En una de mis clases</a>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr><th>Actividad</th><th>Cuándo</th><th>Organiza</th><th></th></tr>
                </thead>
                <tbody>
                    {% for row in weekly %}
                        {% set a = row.activity %}
                        <tr>
                            <td><strong>{{ a.title }}</strong><br><span class="muted">{{ a.groupNames }} · {{ a.subjects|join(', ') }}</span></td>
                            <td>
                                Cada {{ a.weekdays|map(w => w.label|lower)|join(', ', ' y ') }}
                                {% if row.next %}
                                    <br><span class="muted">Próxima: {{ row.next.day|date('d/m', false) }}, {{ row.next.startsAt|date('H:i', false) }}</span>
                                {% else %}
                                    {# Sin sesión en las próximas semanas: el curso se acaba o la clase ya no está en el horario. #}
                                    <br><span class="muted">Sin sesiones en las próximas semanas: ¿ha cambiado el horario?</span>
                                {% endif %}
                            </td>
                            <td>{{ a.organizer ? a.organizer.fullName : 'Nadie (ya no está en el centro)' }}</td>
                            <td class="row-actions">{% if a.isOrganizedBy(app.user) or is_granted('ROLE_ADMIN') %}<a href="{{ path('family_activity_edit', { id: a.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    {% for a in oneOffs %}
                        <tr>
                            <td><strong>{{ a.title }}</strong></td>
                            <td><time datetime="{{ a.startAt|date('c', false) }}">{{ a.startAt|date('d/m/Y', false) }}</time>, {{ a.startAt|date('H:i', false) }}{% if a.endAt %}–{{ a.endAt|date('H:i', false) }}{% endif %}</td>
                            <td>{{ a.organizer ? a.organizer.fullName : 'Nadie (ya no está en el centro)' }}</td>
                            <td class="row-actions">{% if a.isOrganizedBy(app.user) or is_granted('ROLE_ADMIN') %}<a href="{{ path('family_activity_edit', { id: a.id }) }}">Editar</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>

    {# Sin nombres: para elegir el día basta saber cuántas familias pueden y a qué horas. #}
    <section class="card" aria-labelledby="family-availability-title">
        <h2 id="family-availability-title">Cuándo pueden venir las familias</h2>
        {% if availability is empty %}
            <p class="muted">Ninguna familia ha dicho todavía qué días puede venir.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>Día</th><th>Familias</th><th>Horas</th></tr>
                </thead>
                <tbody>
                    {% for day in weekdays %}
                        {% set spans = availability[day.value] ?? [] %}
                        <tr>
                            <th scope="row">{{ day.label }}</th>
                            <td>{{ spans|length }}</td>
                            <td>{{ spans is empty ? '—' : spans|map(s => s.from|date('H:i', false) ~ '–' ~ s.until|date('H:i', false))|join(', ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}

{% extends 'app_shell.html.twig' %}

{% block title %}Nueva actividad con familias · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('family_activity_index') }}">Actividades con familias</a><span class="sep">/</span>Nueva{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>{{ weekly ? 'Actividad en una de tus clases' : 'Actividad puntual' }}</h1>
            <p class="lead">{{ weekly ? 'Cada semana que des esa clase, las familias podrán apuntarse a la sesión.' : 'Un día y una hora sueltos, fuera del horario de clase.' }} Quedará a tu nombre: solo tú podrás cambiarla o borrarla.</p>
        </div>
    </div>

    <div class="card">
        {% if weekly and not hasClasses %}
            {# Sin clases en las próximas semanas no hay de dónde elegir: lo más probable es que el horario no esté importado. #}
            <div class="empty-state">
                <h2>No tienes clases en las próximas semanas</h2>
                <p>Si el horario del curso ya está importado, puede que te toquen vacaciones. Puedes publicar una actividad puntual.</p>
                <a class="btn" href="{{ path('family_activity_new') }}">Actividad puntual</a>
            </div>
        {% else %}
            {{ include('family_activity/_form.html.twig', { submitLabel: 'Publicar actividad' }) }}
        {% endif %}
    </div>
{% endblock %}

{% block page_scripts %}
    {% if weekly %}<script src="{{ asset_ver('/js/class-pick.js') }}"></script>{% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Protección de datos · {{ app_organization_name }}{% endblock %}

{# Sin la barra del espacio de familias a propósito, como la lectura del personal: hasta aceptar no hay
   adónde ir. #}
{% block shell %}
    <main class="privacy-page">
        <article class="privacy-sheet">
            {% if notice %}
                {{ include('privacy_notice/_head.html.twig', { lead: 'Antes de empezar, lee qué datos tuyos usa el centro en este espacio y para qué. Solo te lo volveremos a pedir si el texto cambia.' }) }}

                {{ include('privacy_notice/_text.html.twig') }}

                <footer class="privacy-sheet__foot">
                    <form method="post" action="{{ path('family_consent_give') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('family_consent') }}">
                        <input type="hidden" name="version" value="{{ notice.id }}">
                        <button class="btn" type="submit">Acepto</button>
                    </form>
                    {# Aquí sí es un consentimiento, y decir que no tiene que ser igual de fácil: un botón,
                       que borra la cuenta, no un «Salir» que la deja guardada sin poder usarla. #}
                    <form method="post" action="{{ path('family_leave') }}"
                          data-confirm="Se borrarán tu cuenta y tus datos, y ya no podrás entrar. Si más adelante quieres colaborar, el centro puede volver a darte de alta. ¿Seguir?">
                        <input type="hidden" name="_token" value="{{ csrf_token('family_leave') }}">
                        <button class="btn secondary" type="submit">No acepto: borrar mi cuenta</button>
                    </form>
                    <p class="privacy-sheet__note">Colaborar es voluntario. Si aceptas, puedes retirar tu consentimiento cuando quieras con «Darme de baja», al pie de cada página: se borran tu cuenta y tus datos.</p>
                    <a class="privacy-sheet__exit" href="{{ path('family_logout') }}">Salir sin decidir ahora</a>
                </footer>
            {% else %}
                {{ include('privacy_notice/_head.html.twig', { lead: 'El centro todavía no ha publicado la información sobre protección de datos para familias, y hasta entonces este espacio no se puede usar.' }) }}
                <footer class="privacy-sheet__foot">
                    <a class="btn secondary" href="{{ path('family_logout') }}">Salir</a>
                </footer>
            {% endif %}
        </article>
    </main>
{% endblock %}

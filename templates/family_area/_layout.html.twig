{% extends 'base.html.twig' %}

{# El espacio de familias: una sola columna, sin el menú del personal. Nada de app_shell, que enlaza a
   pantallas del firewall del personal en las que una familia no puede entrar. #}

{% block shell %}
    <div class="family-area">
        <header class="family-area__bar">
            <span class="brand">
                <span class="brand-mark">{{ include('partials/_brand_mark.html.twig', { size: 30 }) }}</span>
                <span class="brand-name">{{ app_organization_name }}</span>
            </span>
            {% if app.user %}
                <span class="family-area__who">
                    {{ app.user.fullName }}
                    <a href="{{ path('family_logout') }}">Salir</a>
                </span>
            {% endif %}
        </header>
        <main class="page family-area__page">
            {{ include('partials/_flashes.html.twig') }}
            {% block body %}{% endblock %}
        </main>
        {% if app.user %}
            {# Retirar el consentimiento tiene que ser tan fácil como darlo: a un botón desde cualquier página. #}
            <footer class="family-area__foot">
                <a href="{{ path('family_privacy_public') }}">Protección de datos</a>
                <form method="post" action="{{ path('family_leave') }}"
                      data-confirm="Se borrarán tu cuenta y tus datos (las actividades a las que te has apuntado y los días en que puedes venir), y ya no podrás entrar. ¿Darte de baja?">
                    <input type="hidden" name="_token" value="{{ csrf_token('family_leave') }}">
                    <button class="family-area__leave" type="submit">Darme de baja</button>
                </form>
            </footer>
        {% endif %}
    </div>
{% endblock %}

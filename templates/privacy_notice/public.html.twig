{% extends 'base.html.twig' %}

{% block title %}Protección de datos · {{ app_organization_name }}{% endblock %}

{% block shell %}
    <main class="privacy-page">
        <article class="privacy-sheet">
            {% if notice %}
                {{ include('privacy_notice/_head.html.twig', { lead: 'Qué datos del personal usa esta aplicación, para qué y con qué derechos.' }) }}
                {{ include('privacy_notice/_text.html.twig', { open: true }) }}
            {% else %}
                {{ include('privacy_notice/_head.html.twig', { lead: 'El centro todavía no ha publicado la información sobre protección de datos de esta aplicación.' }) }}
            {% endif %}
            <footer class="privacy-sheet__foot">
                <a class="btn secondary" href="{{ app.user ? path('app_homepage') : path('login') }}">{{ app.user ? 'Volver a la aplicación' : 'Ir a la entrada' }}</a>
            </footer>
        </article>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Revisa tu correo{% endblock %}

{% block shell %}
    <div class="auth">
        <div class="auth-card">
            <div class="brand-mark brand-mark--lg">{{ include('partials/_brand_mark.html.twig', { size: 76, wordmark: true }) }}</div>

            <h1>Revisa tu correo</h1>
            <p class="auth-lead">Si <strong>{{ email }}</strong> corresponde a una cuenta registrada, te hemos enviado un enlace para entrar. Es válido durante 10 minutos.</p>
            {# Compartida por el acceso del personal y el de familias: cada uno vuelve a su propia página. #}
            <a class="btn secondary" href="{{ path(back_route ?? 'login') }}">Volver</a>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Entrar{% endblock %}

{% block shell %}
    <div class="auth">
        <div class="auth-card">
            <div class="brand-mark brand-mark--lg">{{ include('partials/_brand_mark.html.twig', { size: 76, wordmark: true }) }}</div>

            <h1>Entrar</h1>
            {% if email %}
                <p class="auth-lead">Vas a entrar como <strong>{{ email }}</strong>.</p>
            {% endif %}
            <form method="post" action="{{ action }}">
                <button type="submit" class="btn">Entrar</button>
            </form>
        </div>
    </div>
{% endblock %}

{% extends 'app_shell.html.twig' %}
{% import 'booking/_cells.html.twig' as grid %}

{% block title %}Reservas · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span>Reservas{% endblock %}

{% block body %}
    {% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}
    {% set meses = ['', 'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}
    {% set diaStr = day|date('Y-m-d', false) %}

    <div class="page-head">
        <div>
            <p class="eyebrow">Espacios y material</p>
            <h1>Reservar</h1>
            <p class="lead">Pincha en las horas libres de lo que necesites. Puedes marcar varias horas seguidas de la misma cosa.</p>
        </div>
    </div>

    {{ include('booking/_tabs.html.twig', { active: 'dia' }) }}

    {% if not hasCatalogue %}
        <div class="card">
            {% set puedeEspacios = is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::ESPACIOS')) %}
            <p class="muted">No hay nada que reservar todavía. El material lo da de alta administración, en «Material»; los espacios se abren a reservas {% if puedeEspacios %}en <a href="{{ path('space_room_classify') }}">Clasificar los espacios</a>{% else %}desde <strong>Espacios → Catálogo</strong>{% endif %}.</p>
        </div>
    {% else %}
        {{ include('booking/_when_what.html.twig', { route: 'booking_index', focus: day }) }}
        {{ include('booking/_legend.html.twig') }}

        {% if periodsBorrowedFrom %}
            <p class="help">Horas del curso {{ periodsBorrowedFrom }}: el horario de este curso todavía no está importado. Se guarda el tramo, no la hora, así que si el horario nuevo mueve los timbres las reservas ya hechas se verán con las horas nuevas.</p>
        {% elseif slotTimes is empty %}
            <p class="help">Todavía no hay ningún horario importado, así que estas seis horas son genéricas y puede que no coincidan con los tramos del centro.</p>
        {% endif %}
        {% if isPast %}
            <p class="help">Este día ya ha pasado: se ve lo que hubo, pero no se reserva. <a href="{{ path('booking_index', { tipo: type }) }}">Volver a hoy</a>.</p>
        {% endif %}

        <div class="table-scroll card booking-grid">
            <table class="bgrid">
                <caption>{{ dias[day|date('N', false)] }} {{ day|date('j', false) }} de {{ meses[day|date('n', false)] }}</caption>
                <thead>
                    <tr>
                        <th scope="col">Recurso</th>
                        {% for slot in slotIds %}
                            <th scope="col">{{ loop.index }}ª{% if slotTimes[slot] is defined %}<span class="mono">{{ slotTimes[slot].startsAt|date('G:i', false) }}</span>{% endif %}</th>
                            {% if breaksAfter[slot] is defined %}<th scope="col" class="bgrid__break"><span class="mono">R</span></th>{% endif %}
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <th scope="row">{{ include('booking/_resource_name.html.twig', { r: row.resource }) }}</th>
                            {% for slot in slotIds %}
                                <td>{{ grid.day(row.cells[slot], loop.index ~ 'ª', row.resource.name ~ ' · ' ~ dias[day|date('N', false)] ~ ' ' ~ day|date('j', false) ~ ' ' ~ meses[day|date('n', false)]|slice(0, 3)) }}</td>
                                {% if breaksAfter[slot] is defined %}<td class="bgrid__break" aria-hidden="true"><span></span></td>{% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if not isPast %}
            {{ include('booking/_reserve_bar.html.twig') }}
        {% endif %}
    {% endif %}

    {{ include('booking/_mine.html.twig') }}

    <script src="{{ asset_ver('/js/booking-grid.js') }}"></script>
{% endblock %}

{% extends 'app_shell.html.twig' %}

{% block title %}Seguimiento de reservas · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('booking_index') }}">Reservas</a><span class="sep">/</span>Seguimiento{% endblock %}

{% block body %}
    {% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'] %}

    <div class="page-head">
        <div>
            <p class="eyebrow">Reservas</p>
            <h1>Seguimiento de reservas</h1>
            <p class="lead">Qué se ha reservado esta semana, quién lo tenía y con qué grupo. Sirve para saber a quién preguntar cuando aparece un desperfecto en un aula o en el material.</p>
        </div>
    </div>

    {{ include('booking/_tabs.html.twig', { active: 'seguimiento' }) }}

    {# Semana a semana, no día a día: una avería se descubre días después de causarse, así que la pantalla
       tiene que abarcar más de lo que abarca la de reservar. El selector es el mismo cuadro que en /reservas
       (flechas, rango, «otra fecha» —date-field.js lo realza—) y aquí SÍ hay flecha hacia atrás: mirar el
       pasado es justo para lo que está. #}
    {% set meses = ['', 'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}
    {% set hoy = 'now'|date('Y-m-d', false) %}
    {% set esEstaSemana = hoy >= monday|date('Y-m-d', false) and hoy <= sunday|date('Y-m-d', false) %}
    <section class="booking-when" aria-label="Semana">
        <div class="booking-when__row">
            <span class="booking-when__label">Semana</span>
            <a class="booking-when__arrow" href="{{ path('booking_tracking', { fecha: monday|date_modify('-7 days')|date('Y-m-d', false) }) }}" aria-label="Semana anterior">←</a>
            <span class="booking-when__range">{{ monday|date('j', false) }}{% if monday|date('n', false) != sunday|date('n', false) %} de {{ meses[monday|date('n', false)] }}{% endif %} – {{ sunday|date('j', false) }} de {{ meses[sunday|date('n', false)] }}</span>
            <a class="booking-when__arrow" href="{{ path('booking_tracking', { fecha: monday|date_modify('+7 days')|date('Y-m-d', false) }) }}" aria-label="Semana siguiente">→</a>
            <div class="booking-chips">
                <a href="{{ path('booking_tracking') }}" class="{{ esEstaSemana ? 'is-active' }}"{{ esEstaSemana ? ' aria-current="date"' }}>Esta semana</a>
            </div>
            <form method="get" action="{{ path('booking_tracking') }}" class="booking-when__date">
                <label for="fecha">Otra fecha</label>
                <input type="date" id="fecha" name="fecha" value="{{ monday|date('Y-m-d', false) }}" onchange="this.form.submit()">
                <noscript><button type="submit" class="btn secondary">Ir</button></noscript>
            </form>
        </div>
    </section>

    <p class="help">
        {% if bookings is empty %}Ninguna reserva de lunes a domingo.{% else %}{{ bookings|length }} {{ bookings|length == 1 ? 'reserva' : 'reservas' }} de lunes a domingo. Busca o filtra por cosa, tipo o persona para saber a quién preguntar.{% endif %}
    </p>

    <div class="card">
        {% if bookings is empty %}
            <p class="muted">No hay ninguna reserva en esta semana.</p>
        {% else %}
            {# Una sola tabla con la columna «Día» en vez de una tabla por día: así el buscador y los filtros
               de table-tools actúan sobre la SEMANA entera, que es como se investiga un desperfecto («¿quién
               tuvo el carro 2?»). data-filter en las tres columnas por las que se pregunta.
               La celda del día lleva data-sort con la fecha en número (AAAAMMDD) porque «Lunes 03/08» ordena
               alfabéticamente por el nombre del día, no por la fecha. #}
            <table data-list-tools>
                <thead>
                    <tr>
                        <th>Día</th>
                        <th>Hora</th>
                        <th data-filter="Qué">Qué</th>
                        <th data-filter="Tipo">Tipo</th>
                        <th>Grupo</th>
                        <th data-filter="Quién">Quién</th>
                        <th>Para qué</th>
                    </tr>
                </thead>
                <tbody>
                    {% for b in bookings %}
                        {% set times = slotTimes[b.slotIndex] ?? null %}
                        <tr>
                            <td data-sort="{{ b.date|date('Ymd', false) }}">{{ dias[b.date|date('N', false)] }} {{ b.date|date('d/m', false) }}</td>
                            <td class="mono">{% if times %}{{ times.startsAt|date('H:i', false) }}–{{ times.endsAt|date('H:i', false) }}{% else %}{{ b.slotIndex + 1 }}ª{% endif %}</td>
                            <td><strong>{{ b.resourceName }}</strong></td>
                            <td>{{ b.room ? 'Espacio' : 'Material' }}</td>
                            <td>{{ b.groupName ?? '—' }}</td>
                            {# Quien reservó puede haber sido dado de baja: la reserva sobrevive (booked_by es
                               SET NULL) y entonces esta pantalla no puede decir a quién preguntar. Se dice. En una
                               reserva fija es su titular (persona o departamento). «Fija» va en «Para qué» y no
                               aquí: esta columna filtra por el texto entero de la celda, y «Tecnología (fija)»
                               saldría como otra persona distinta de «Tecnología». #}
                            <td>{{ b.holderName }}</td>
                            <td class="muted">{{ b.purpose }}{% if b.series %} <span class="badge">Fija</span>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if periodsBorrowedFrom %}
                <p class="help">Las horas son las del curso {{ periodsBorrowedFrom }}: el horario de este curso todavía no está importado. De cada reserva se guarda el tramo, no la hora.</p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

{% extends 'app_shell.html.twig' %}

{% block title %}Reservas fijas · {{ app_organization_name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_homepage') }}">Inicio</a><span class="sep">/</span><a href="{{ path('booking_index') }}">Reservas</a><span class="sep">/</span>Reservas fijas{% endblock %}

{# La hora por su ORDINAL en el día (posición en la lista de tramos, no índice: los recreos también ocupan
   índice) y, si se conoce el marco, la de reloj al lado. #}
{% macro hora(ordinals, slotTimes, index) %}
    {%- set times = slotTimes[index] ?? null -%}
    {{ ordinals[index] ?? (index + 1) }}ª{% if times %} <span class="mono muted">{{ times.startsAt|date('H:i', false) }}</span>{% endif %}
{%- endmacro %}

{# Las reservas fijas en curso, una fila cada una. Con `puedeCrear` lleva el botón de terminarla. #}
{% macro lista(series, ordinals, diasCortos, puedeCrear, vacio) %}
    {% if series is empty %}
        <p class="muted">{{ vacio }}</p>
    {% else %}
        <ul class="incident-list">
            {% for s in series %}
                <li class="incident">
                    <div class="incident__main">
                        <span class="incident__head">
                            <span class="incident__what">{{ s.resourceName }}</span>
                            <span class="muted">· {{ s.holderName }}</span>
                        </span>
                        <span class="incident__where">
                            {% for weekday, slots in s.pattern %}{{ diasCortos[weekday] }} {{ slots|map(i => (ordinals[i] ?? (i + 1)) ~ 'ª')|join(', ') }}{{ not loop.last ? ' · ' }}{% endfor %}
                        </span>
                        <span class="incident__where">Del {{ s.startsOn|date('d/m/Y', false) }} al {{ s.endsOn|date('d/m/Y', false) }} · {{ s.purpose }}{% if s.createdBy %} · la creó {{ s.createdBy.fullName }}{% endif %}</span>
                    </div>
                    {% if puedeCrear %}
                        <form method="post" action="{{ path('booking_series_end', { id: s.id }) }}" data-confirm="¿Terminar esta reserva fija? Desde hoy {{ s.resourceName }} queda libre esas horas; lo pasado se conserva.">
                            <input type="hidden" name="_token" value="{{ csrf_token('booking_series_end' ~ s.id) }}">
                            <button type="submit" class="link-danger">Terminar</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% block body %}
    {% set dias = ['', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'] %}
    {% set diasCortos = ['', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie'] %}
    {% set puedeCrear = is_granted(constant('App\\Security\\Voter\\AreaVoter::WRITE'), constant('App\\Enum\\Area::RESERVAS_FIJAS')) %}

    <div class="page-head">
        <div>
            <p class="eyebrow">Espacios y material</p>
            <h1>Reservas fijas</h1>
            <p class="lead">Carros y aulas cogidos las mismas horas cada semana. Se saltan los días no lectivos, y quien la tiene puede liberar un día suelto desde la pantalla del día.</p>
        </div>
    </div>

    {{ include('booking/_tabs.html.twig', { active: 'fijas' }) }}

    {% if not puedeCrear %}
        <div class="card">{{ _self.lista(series, ordinals, diasCortos, false, 'No hay ninguna reserva fija en curso.') }}</div>
    {% else %}
        <div class="fixed-new">
            {% if errors is not empty %}
                <div class="flash error" role="alert">
                    {% for e in errors %}<p>{{ e }}</p>{% endfor %}
                    {% if clashes is not empty %}
                        <ul>
                            {#- Los primeros doce: una serie de todo el curso contra otra choca ochenta veces, y con ver
                                cuáles y cuántas basta para saber qué quitar. -#}
                            {% for c in clashes|slice(0, 12) %}
                                <li>{% if c.date %}{{ dias[c.weekday.value] }} {{ c.date|date('d/m/Y', false) }}{% else %}Todos los {{ dias[c.weekday.value]|lower }}{% endif %} a {{ _self.hora(ordinals, slotTimes, c.slotIndex) }}: {{ c.what }}</li>
                            {% endfor %}
                            {% if clashes|length > 12 %}<li>… y {{ clashes|length - 12 }} más.</li>{% endif %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}

            <div class="fixed-layout">
                {#- Paso 1: qué. Enlaces y no un desplegable: cada cosa es una dirección (se puede compartir) y la
                    rejilla de sus horas se pinta en el servidor, sin JavaScript. -#}
                <nav class="fixed-resources" aria-labelledby="paso1" data-resource-filter>
                    <p id="paso1" class="eyebrow">1 · Qué</p>
                    <input type="search" class="fixed-resources__search" placeholder="Buscar un carro, un aula…" aria-label="Buscar entre las cosas que se pueden reservar" autocomplete="off" hidden>
                    {% for group in groups %}
                        <div class="fixed-resources__group" data-resource-group>
                            <p class="fixed-resources__heading">{{ group.label }}</p>
                            {% for r in group.items %}
                                {% set on = selectedKey == r.key %}
                                <a href="{{ path('booking_series_index', { recurso: r.key }) }}" class="fixed-res{{ on ? ' is-on' }}"{{ on ? ' aria-current="true"' }} data-resource>{{ r.name }}{% if r.where %}<small>{{ r.where }}</small>{% endif %}</a>
                            {% endfor %}
                        </div>
                    {% endfor %}
                    <p class="muted fixed-resources__none" data-resource-none hidden>Nada coincide con lo que has escrito.</p>
                </nav>

                <div class="fixed-main">
                    {% if selected is null %}
                        <p class="muted">Elige a la izquierda qué quieres reservar: aquí saldrán sus horas de la semana.</p>
                    {% else %}
                        {% set franjas = sent.franjas ?? [] %}
                        <form method="post" action="{{ path('booking_series_new') }}" class="fixed-steps" data-fixed-form>
                            <input type="hidden" name="_token" value="{{ csrf_token('booking_series_new') }}">
                            <input type="hidden" name="recurso" value="{{ selectedKey }}">

                            <fieldset class="card fixed-step">
                                <legend class="fixed-step__legend"><span class="eyebrow">2 · Sus horas cada semana</span><span class="fixed-step__title">{{ selected.name }}</span></legend>
                                <p class="help">Marca las horas una a una (o el día entero). Lo que tiene clase no se puede marcar; si ya hay reservas ese día, te lo decimos antes de guardar.</p>
                                <div class="table-scroll">
                                    <table class="fixed-grid">
                                        <thead>
                                            <tr>
                                                <th scope="col">Día</th>
                                                {% for index in slotIndexes %}<th scope="col">{{ _self.hora(ordinals, slotTimes, index) }}</th>{% endfor %}
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for w in weekdays %}
                                                <tr>
                                                    <th scope="row">
                                                        {{ dias[w.value] }}
                                                        <button type="button" class="fixed-dayhead" data-pick-day hidden>marcar el día</button>
                                                    </th>
                                                    {% for index in slotIndexes %}
                                                        {% set cell = grid[w.value][index] %}
                                                        <td>
                                                            {% if cell.lesson %}
                                                                <div class="fcell fcell--class" title="{{ cell.lesson.what }}"><span class="visually-hidden">{{ dias[w.value] }} a {{ ordinals[index] ?? (index + 1) }}ª: </span><span class="fcell__main">Clase</span><span class="fcell__sub">del horario</span></div>
                                                            {% else %}
                                                                {% set value = w.value ~ ':' ~ index %}
                                                                {% set known = cell.bookings|map(c => { d: c.date|date('Y-m-d', false), t: dias[c.weekday.value] ~ ' ' ~ c.date|date('d/m/Y', false) ~ ' a ' ~ (ordinals[index] ?? (index + 1)) ~ 'ª: ' ~ c.what }) %}
                                                                <label class="fcell fcell--free"{% if known is not empty %} data-clashes="{{ known|json_encode }}"{% endif %}>
                                                                    <input type="checkbox" name="franjas[]" value="{{ value }}"{{ value in franjas ? ' checked' }}>
                                                                    <span class="visually-hidden">{{ dias[w.value] }} a {{ ordinals[index] ?? (index + 1) }}ª</span>
                                                                    <span class="fcell__off" aria-hidden="true">+</span>
                                                                    <span class="fcell__on" aria-hidden="true">✓ {{ ordinals[index] ?? (index + 1) }}ª</span>
                                                                    {% if known is not empty %}<span class="fcell__sub">ya hay reservas</span>{% endif %}
                                                                </label>
                                                            {% endif %}
                                                        </td>
                                                    {% endfor %}
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </fieldset>

                            {#- Persona O departamento: un carro de Tecnología no es de quien dé la clase ese año. Primero el tipo
                                y luego solo esa lista: las ochenta personas en un desplegable detrás de los departamentos no
                                se veían. La otra lista la esconde el CSS (:has); sin él se ven las dos y manda el tipo. -#}
                            {% set holderKind = sent.titular_tipo ?? 'dept' %}
                            <div class="card fixed-step">
                                <p class="eyebrow">3 · Para quién y hasta cuándo</p>
                                <div class="fixed-step__row">
                            <fieldset class="field holder-picker fixed-step__col">
                                <legend>Es de</legend>
                                <div class="pick-chips">
                                    <label class="pick-chip"><input type="radio" name="titular_tipo" value="dept" required{{ holderKind == 'dept' ? ' checked' }}> Un departamento</label>
                                    <label class="pick-chip"><input type="radio" name="titular_tipo" value="user"{{ holderKind == 'user' ? ' checked' }}> Una persona</label>
                                </div>
                                <div class="holder-picker__kind" data-holder-kind="user">
                                    <div class="pick-list" data-pick-search="Busca a la persona por nombre o departamento…">
                                        {% for u in users %}
                                            <label class="pick-option">
                                                <input type="radio" class="pick-option__input" name="titular_persona" value="{{ u.id }}"{{ (sent.titular_persona ?? '') == u.id ~ '' ? ' checked' }}>
                                                <span class="pick-option__body">
                                                    <span class="pick-option__name">{{ u.fullName }}</span>
                                                    <span class="pick-option__desc">{{ u.unit ? u.unit.name : 'Sin departamento' }}</span>
                                                </span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="holder-picker__kind" data-holder-kind="dept">
                                    <label for="titular_departamento" class="visually-hidden">Departamento</label>
                                    <select id="titular_departamento" name="titular_departamento">
                                        <option value="">— Elige el departamento —</option>
                                        {% for d in departments %}<option value="{{ d.id }}"{{ (sent.titular_departamento ?? '') == d.id ~ '' ? ' selected' }}>{{ d.name }}</option>{% endfor %}
                                    </select>
                                    <p class="help">Puede liberar un día su jefatura de departamento.</p>
                                </div>
                            </fieldset>
                                    <div class="field fixed-step__col fixed-step__col--wide">
                                        <label for="motivo">Para qué</label>
                                        <input type="text" id="motivo" name="motivo" maxlength="200" required value="{{ sent.motivo ?? '' }}" placeholder="Clases de Tecnología, programación de 4º…">
                                    </div>
                                </div>

                                {#- «Desde … hasta» como el diseño: la serie empieza el día de la pantalla y el tope se elige con chips.
                                    El servidor solo lee `desde` y `hasta`; los chips son una comodidad (con JavaScript fijan la fecha
                                    y esconden el campo; sin él, el campo está siempre a la vista). -#}
                                {% set diasLargos = ['', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'] %}
                                {% set meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'] %}
                                {% set mesesLargos = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'] %}
                                {% set desde = sent.desde ?? today|date('Y-m-d', false) %}
                                {% set yearEnd = defaultTo ? defaultTo|date('Y-m-d', false) : '' %}
                                {% set xmasEnd = christmasEnd ? christmasEnd|date('Y-m-d', false) : '' %}
                                {% set hasta = sent.hasta ?? yearEnd %}
                                {% set untilCustom = (hasta != yearEnd or '' == yearEnd) and (hasta != xmasEnd or '' == xmasEnd) %}
                                <fieldset class="fixed-step__until" data-until>
                                    <legend>Desde el {{ diasLargos[desde|date('N', false)] }} {{ desde|date('j', false) }} de {{ mesesLargos[desde|date('n', false) - 1] }} hasta</legend>
                                    <input type="hidden" id="desde" name="desde" value="{{ desde }}">
                                    <div class="pick-chips">
                                        {% if yearEnd %}<label class="pick-chip"><input type="radio" name="hasta_tipo" value="curso" data-date="{{ yearEnd }}"{{ hasta == yearEnd ? ' checked' }}> Fin de curso ({{ yearEnd|date('j', false) }} {{ meses[yearEnd|date('n', false) - 1] }})</label>{% endif %}
                                        {% if xmasEnd %}<label class="pick-chip"><input type="radio" name="hasta_tipo" value="navidad" data-date="{{ xmasEnd }}"{{ hasta == xmasEnd and hasta != yearEnd ? ' checked' }}> Navidad ({{ xmasEnd|date('j', false) }} {{ meses[xmasEnd|date('n', false) - 1] }})</label>{% endif %}
                                        <label class="pick-chip"><input type="radio" name="hasta_tipo" value="otra"{{ untilCustom ? ' checked' }}> Otra fecha</label>
                                        <span data-until-custom>
                                            <label for="hasta" class="visually-hidden">Fecha del último día</label>
                                            <input type="date" id="hasta" name="hasta" required value="{{ hasta }}">
                                        </span>
                                    </div>
                                </fieldset>

                                <div class="flash error" role="alert" data-fixed-clashes hidden></div>

                                <div class="fixed-step__foot">
                                    <p class="fixed-step__summary" data-fixed-summary aria-live="polite"></p>
                                    <button type="submit" class="btn" data-fixed-submit>Crear reserva fija</button>
                                </div>
                                <p class="help">Si algún día ya lo tiene otra persona, o el horario tiene clase en esa aula a esa hora, no se reserva nada y se te dice qué choca. Como mucho, hasta el final del curso.</p>
                            </div>
                        </form>
                        <script src="{{ asset_ver('/js/booking-fixed-grid.js') }}"></script>
                    {% endif %}

                    {#- Las fijas de la cosa elegida (o todas, si no hay ninguna elegida), debajo de donde se crea. -#}
                    {% set ofSelected = selected is null ? series : series|filter(x => (x.room ? 'room:' ~ x.room.id : 'material:' ~ x.material.id) == selectedKey) %}
                    <section class="fixed-existing" aria-labelledby="existentes">
                        <h2 id="existentes">{{ selected is null ? 'Reservas fijas en curso' : 'Reservas fijas de ' ~ selected.name }}</h2>
                        <div class="card">{{ _self.lista(ofSelected, ordinals, diasCortos, true, selected is null ? 'No hay ninguna reserva fija en curso.' : 'Ninguna todavía.') }}</div>
                    </section>
                </div>
            </div>
        </div>
        <script src="{{ asset_ver('/js/fixed-resource-filter.js') }}"></script>
    {% endif %}
{% endblock %}

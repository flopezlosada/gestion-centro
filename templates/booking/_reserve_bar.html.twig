{# La barra «Vas a reservar», compartida por el día y la semana. Las casillas de la rejilla se asocian a
   este formulario con form="reservar" (no pueden estar DENTRO: la rejilla lleva sus propios formularios de
   «Anular», y un formulario no se anida en otro). Sin JavaScript queda siempre a la vista, al final; con
   él, booking-grid.js la esconde hasta que hay algo marcado, la flota abajo y escribe qué se ha marcado. #}
<form method="post" action="{{ path('booking_new') }}" id="reservar" class="booking-bar" data-booking-bar aria-label="Confirmar reserva">
    <input type="hidden" name="_token" value="{{ csrf_token('booking_new') }}">
    <input type="hidden" name="vista" value="{{ view }}">
    <div class="booking-bar__what">
        <span class="booking-bar__eyebrow">Vas a reservar</span>
        <strong data-booking-title>Marca horas libres de una sola cosa y un solo día</strong>
        <span class="booking-bar__when" data-booking-summary></span>
    </div>
    <div class="field booking-bar__purpose">
        <label for="motivo">Para qué</label>
        <input type="text" id="motivo" name="motivo" maxlength="200" required placeholder="Ej.: examen de recuperación">
    </div>
    {#- Los grupos del horario, varios a la vez. Sin horario importado no hay lista y el campo no sale. -#}
    {% if groupNames is not empty %}
        <div class="field booking-bar__groups">
            <label for="grupos">Grupo <span class="muted">(opcional)</span></label>
            <select id="grupos" name="grupos[]" multiple>
                {% for g in groupNames %}<option value="{{ g }}">{{ g }}</option>{% endfor %}
            </select>
        </div>
    {% endif %}
    <div class="form-actions">
        <button type="button" class="btn secondary" data-booking-clear hidden>Quitar</button>
        <button type="submit" class="btn" data-booking-submit>Reservar</button>
    </div>
</form>
